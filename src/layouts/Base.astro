---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '@/components/shell/Nav.astro';
import Footer from '@/components/shell/Footer.astro';
import MentionPreviews from '@/components/shell/MentionPreviews.astro';
import I18n from '@/components/shell/I18n.astro';
import { site } from '@/data/profile';
import { stripLocalePrefix } from '@/lib/locale';
import { canonicalUrl, isEnglishBuildPath } from '@/lib/hosts';
import { markdownAssetPath } from '@/lib/accept';
import { siteJsonLd } from '@/lib/agent';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  split?: boolean;
  /** Other language versions of this page, as absolute URLs. */
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description = site.description,
  ogImage = '/og-default.svg',
  split = false,
  alternates = [],
} = Astro.props;
const lang = Astro.locals.lang === 'en' ? 'en' : 'zh-CN';
const pageTitleZh = title ? `${title} · ${site.title}` : `${site.title} — ${lang === 'en' ? 'Blog' : '博客'}`;
const pageTitle = pageTitleZh;
const pageDescription = description;
const canonicalPath = stripLocalePrefix(Astro.url.pathname);
const english = isEnglishBuildPath(canonicalPath);
const canonical = canonicalUrl(canonicalPath);
const markdownUrl = english ? null : new URL(markdownAssetPath(canonicalPath), site.url);
const jsonLd = siteJsonLd();
---

<!doctype html>
<html
  lang={lang}
  data-lang={lang}
  class:list={[split && 'reading-split']}
  data-title-zh={pageTitleZh}
  data-desc-zh={description}
>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      {
        // ClientRouter 换页会用新文档的 <html> 属性覆盖当前 data-theme；
        // 源码里没有该属性，且本脚本全站相同、默认不重跑。须在 swap 前后写回。
        function applyPrefs(root) {
          var doc = root.ownerDocument || document;
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme =
            stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
          var lang = root.getAttribute('data-lang') || 'zh-CN';
          root.dataset.theme = theme;
          root.lang = lang;
          root.dataset.lang = lang;
          var title =
            root.getAttribute('data-title-zh');
          if (title) doc.title = title;
          var desc =
            root.getAttribute('data-desc-zh');
          var meta = doc.querySelector('meta[name="description"]');
          if (meta && desc) meta.setAttribute('content', desc);
          var themeColor = doc.querySelector('meta#theme-color');
          if (themeColor) themeColor.setAttribute('content', theme === 'dark' ? '#191919' : '#ffffff');
        }
        try {
          applyPrefs(document.documentElement);
          document.addEventListener('astro:before-swap', function (e) {
            applyPrefs(e.newDocument.documentElement);
          });
          document.addEventListener('astro:after-swap', function () {
            applyPrefs(document.documentElement);
          });
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
          document.documentElement.lang = 'zh-CN';
          document.documentElement.dataset.lang = 'zh-CN';
        }
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    {alternates.length > 0 && <link rel="alternate" hreflang={lang} href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" id="theme-color" content="#ffffff" />
    <ClientRouter />
  </head>
  <body class:list={['flex min-h-screen flex-col', split && 'md:h-dvh md:overflow-hidden']}>
    <MentionPreviews />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:px-3 focus:py-2 focus:text-ink-100"
    >
      <I18n k="skipToContent" />
    </a>
    <Nav />
    <main id="main" class:list={['site-main flex-1', split && 'md:flex md:min-h-0 md:flex-col md:overflow-hidden']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
