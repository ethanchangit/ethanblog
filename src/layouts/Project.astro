---
import Base from '@/layouts/Base.astro';
import { statusLabel } from '@/lib/format';
import I18n from '@/components/shell/I18n.astro';
import Bi from '@/components/shell/Bi.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, nameEn, tagline, taglineEn, status, stack, platforms, repo, homepage, downloads, screenshots } =
  project.data;
const badge = statusLabel[status];
---

<Base title={name} titleEn={nameEn} description={tagline} descriptionEn={taglineEn}>
  <article class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <div class="mb-3 flex items-center gap-3">
        <span class:list={['text-xs font-medium', badge.class]}>
          <Bi zh={badge.text} en={badge.textEn} />
        </span>
        {
          platforms.map((p) => (
            <span class="ui-meta">{p}</span>
          ))
        }
      </div>
      <h1 class="text-3xl font-semibold text-ink-100 sm:text-4xl">
        <Bi zh={name} en={nameEn} />
      </h1>
      <p class="mt-3 text-lg text-ink-400">
        <Bi zh={tagline} en={taglineEn} />
      </p>
    </header>

    <div class="grid gap-10 lg:grid-cols-[1fr_240px]">
      <div>
        {
          screenshots.length > 0 && (
            <div class="mb-10 grid gap-4 sm:grid-cols-2">
              {screenshots.map((s) => (
                <img
                  src={s.src}
                  alt={s.alt}
                  loading="lazy"
                />
              ))}
            </div>
          )
        }
        <div class="prose-site">
          <slot />
        </div>
      </div>

      <aside class="lg:sticky lg:top-20 lg:self-start">
        {
          (repo || homepage) && (
            <div class="flex flex-col gap-3">
              {homepage && (
                <a
                  href={homepage}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-ink-200 underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100"
                >
                  <I18n k="visitSite" />
                </a>
              )}
              {repo && (
                <a
                  href={repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-ink-400 underline decoration-ink-600 underline-offset-4 transition-colors hover:text-ink-200"
                >
                  <I18n k="githubRepo" />
                </a>
              )}
            </div>
          )
        }
        {
          downloads.length > 0 && (
            <div class="mt-6">
              <h2 class="ui-section-label"><I18n k="downloads" /></h2>
              <ul class="flex flex-col gap-2">
                {downloads.map((d) => (
                  <li>
                    <a
                      href={d.url}
                      class="flex items-center justify-between text-sm text-ink-200 transition-colors hover:text-ink-100"
                    >
                      <span>{d.label}</span>
                      {d.platform && <span class="ui-meta">{d.platform}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          stack.length > 0 && (
            <div class="mt-6">
              <h2 class="ui-section-label"><I18n k="techStack" /></h2>
              <ul class="flex flex-wrap gap-x-3 gap-y-1">
                {stack.map((item) => (
                  <li class="ui-tag">{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    <footer class="mt-16 pt-8">
      <a href="/projects" class="ui-link-subtle">
        <I18n k="backToProjects" />
      </a>
    </footer>
  </article>
</Base>
