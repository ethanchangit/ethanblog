---
import Base from '@/layouts/Base.astro';
import { sourceTypeLabel } from '@/lib/format';
import BookmarkButton from '@/components/shell/BookmarkButton.svelte';
import ReadingProgress from '@/components/shell/ReadingProgress.svelte';
import Toc from '@/components/shell/Toc.astro';
import PageHistory from '@/components/shell/PageHistory.astro';
import ArticleComments from '@/components/shell/ArticleComments.svelte';
import { getSession } from '@/lib/auth';
import { listComments } from '@/lib/db';
import type { ArticleComment } from '@/lib/comments';
import { isSiteOwner } from '@/lib/user';
import I18n from '@/components/shell/I18n.astro';
import Bi from '@/components/shell/Bi.astro';
import DateText from '@/components/shell/DateText.astro';
import { getFileHistory } from '@/lib/history';
import { copy } from '@/lib/i18n';
import TagList from '@/components/shell/TagList.astro';
import CopyUrl from '@/components/shell/CopyUrl.svelte';
import { articleHref } from '@/lib/routes';
import { site } from '@/data/profile';
import type { CollectionEntry } from 'astro:content';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

/** notebook 前后篇导航的精简条目 */
interface NoteNav {
  id: string;
  title: string;
  titleEn?: string;
}

interface Props {
  article: CollectionEntry<'articles'>;
  headings?: TocHeading[];
  headingsEn?: TocHeading[];
  prev?: NoteNav;
  next?: NoteNav;
}

const { article, headings = [], headingsEn = [], prev, next } = Astro.props;
const { title, titleEn, description, descriptionEn, date, updated, kind, tags, source } =
  article.data;
const slug = article.id;
const canonicalUrl = new URL(Astro.url.pathname, site.url).href;

const commits = article.data.history ? getFileHistory(article.filePath) : [];

const sourceLabel = source ? sourceTypeLabel[source.type] : undefined;
const sourceOrigin = source?.origin;
const sourceDate = source?.date;

const isNotebook = kind === 'notebook';

let initialComments: ArticleComment[] = [];
try {
  const env = Astro.locals.runtime?.env;
  const db = env?.DB;
  if (db) {
    let includePrivate = false;
    if (env) {
      try {
        const session = await getSession(Astro.request, env);
        includePrivate = isSiteOwner(session?.user);
      } catch {
        includePrivate = false;
      }
    }
    initialComments = await listComments(db, slug, { includePrivate });
  }
} catch {
  initialComments = [];
}
---

<Base title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn}>
  <ReadingProgress client:load slug={slug} />

  <div class="article-shell relative mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <header class="article-lede">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3">
          <time datetime={date.toISOString()} class="ui-meta">
            <DateText date={date} />
          </time>
          {
            updated && (
              <span class="ui-meta">
                <I18n k="updatedPrefix" />{' '}
                <DateText date={updated} />
              </span>
            )
          }
          {
            source && (
              <span class="ui-meta" data-source-line>
                <I18n k="sourcePrefix" />
                {sourceLabel ? <Bi zh={sourceLabel.zh} en={sourceLabel.en} /> : source.type}
                {sourceOrigin ? ` · ${sourceOrigin}` : ''}
                {sourceDate ? (
                  <>
                    {' · '}
                    <DateText date={sourceDate} />
                  </>
                ) : null}
              </span>
            )
          }
        </div>
        <BookmarkButton client:load slug={slug} />
      </div>
      <h1 class="text-3xl font-semibold leading-snug text-ink-100 sm:text-4xl">
        <Bi zh={title} en={titleEn} />
      </h1>
      {
        isNotebook && (
          <p class="mt-4 text-lg leading-relaxed text-ink-400">
            <Bi zh={description} en={descriptionEn} />
          </p>
        )
      }
      {isNotebook && <TagList tags={tags} />}
    </header>

    <CopyUrl client:visible url={canonicalUrl} />

    <div class:list={['article-body-row', isNotebook ? 'mt-12' : 'relative mt-6']}>
      {!isNotebook && <Toc headings={headings} headingsEn={headingsEn} />}

      <article class="article-page">
        {
          !isNotebook && (
            <header class="article-dek mb-12">
              <p class="ui-section-label">
                <I18n k="abstract" />
              </p>
              <p class="text-lg leading-relaxed text-ink-400">
                <Bi zh={description} en={descriptionEn} />
              </p>
              <TagList tags={tags} />
            </header>
          )
        }

        <div class="article-main">
          <div class="prose-site">
            <slot />
          </div>

          <footer class="mt-16 space-y-8 pt-8">
            <ArticleComments client:visible slug={slug} comments={initialComments} />

            {commits.length > 0 && <PageHistory commits={commits} />}

            {
              isNotebook && (prev || next) && (
                <nav class="flex items-baseline justify-between gap-4 text-sm" aria-label={copy['zh-CN'].prevNextAria} data-i18n-aria="prevNextAria">
                  <span>
                    {prev && (
                      <a href={articleHref(prev.id)} class="ui-link">
                        ← <Bi zh={prev.title} en={prev.titleEn} />
                      </a>
                    )}
                  </span>
                  <span class="text-right">
                    {next && (
                      <a href={articleHref(next.id)} class="ui-link">
                        <Bi zh={next.title} en={next.titleEn} /> →
                      </a>
                    )}
                  </span>
                </nav>
              )
            }
          </footer>
        </div>
      </article>
    </div>
  </div>
</Base>
