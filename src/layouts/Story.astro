---
import Base from '@/layouts/Base.astro';
import { formatDate, formatSeq, sourceTypeLabel } from '@/lib/format';
import { profile, site } from '@/data/profile';
import { getThread } from '@/data/threads';
import BookmarkButton from '@/components/shell/BookmarkButton.svelte';
import ReadingProgress from '@/components/shell/ReadingProgress.svelte';
import Toc from '@/components/shell/Toc.astro';
import PageHistory from '@/components/shell/PageHistory.astro';
import { getFileHistory } from '@/lib/history';
import type { CollectionEntry } from 'astro:content';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

/** notebook 前后篇导航的精简条目 */
interface NoteNav {
  id: string;
  title: string;
  seq: number;
}

interface Props {
  story: CollectionEntry<'stories'>;
  headings?: TocHeading[];
  prev?: NoteNav;
  next?: NoteNav;
}

const { story, headings = [], prev, next } = Astro.props;
const { title, description, date, updated, kind, tags, thread, seq, source } = story.data;
const storySlug = story.id;

// 版本历史即媒介：history: true 时构建期读 git 提交史；无 git / 无 filePath 时静默隐藏
const commits = story.data.history ? getFileHistory(story.filePath) : [];

// 溯源行：这篇内容由什么原始素材转化而来（MEDIUM §6 的页面接口之一）
const sourceParts = source
  ? [
      sourceTypeLabel[source.type] ?? source.type,
      source.origin,
      source.date && formatDate(source.date),
    ].filter(Boolean)
  : [];

// notebook = 编号过程笔记；essay / interactive = 定稿档
const isNotebook = kind === 'notebook';
const threadInfo = getThread(thread);
const threadTitle = threadInfo?.title ?? thread;

// 定稿档署名与「请这样引用」块（UTC 取值，避免构建时区偏移）
const byline = profile.chineseName
  ? `文 / ${profile.name}（${profile.chineseName}）`
  : `文 / ${profile.name}`;
const citeAuthor = profile.chineseName
  ? `${profile.chineseName} (${profile.name})`
  : profile.name;
const citeDate = `${date.getUTCFullYear()}年${date.getUTCMonth() + 1}月`;
const siteHost = new URL(site.url).host;
const citation = `${citeAuthor}. 「${title}」. ${siteHost}, ${citeDate}. ${site.url}/stories/${storySlug}.`;

// 文末招募段的来信入口
const mailtoHref = `mailto:${profile.email}?subject=${encodeURIComponent('关于《' + title + '》')}`;
---

<Base title={title} description={description}>
  {/* 阅读进度条 — 纯 CSS 滚动驱动；登录后 ReadingProgress 岛屿同步到 progress 表 */}
  <div class="progress-track" aria-hidden="true"><div class="progress-thumb"></div></div>
  <ReadingProgress client:load storySlug={storySlug} />

  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 xl:relative">
    <header class="mb-12">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3">
          {
            isNotebook ? (
              <span class="flex flex-wrap items-baseline gap-2 text-xs">
                <a href={`/threads/${thread}`} class="ui-link">
                  研究线：{threadTitle}
                </a>
                <span class="text-ink-500">· 笔记 #{formatSeq(seq ?? 0)}</span>
              </span>
            ) : (
              <span class:list={['text-xs font-medium', kind === 'interactive' ? 'ui-badge ui-badge--active' : 'ui-badge']}>
                {kind === 'interactive' ? '互动故事' : '文章'}
              </span>
            )
          }
          <time datetime={date.toISOString()} class="ui-meta">
            {formatDate(date)}
          </time>
          {
            updated && (
              <span class="ui-meta">更新于 {formatDate(updated)}</span>
            )
          }
          {
            sourceParts.length > 0 && (
              <span class="ui-meta" data-source-line>
                原始素材：{sourceParts.join(' · ')}
              </span>
            )
          }
        </div>
        <BookmarkButton client:load storySlug={storySlug} />
      </div>
      {
        isNotebook && (
          <p class="mb-4 text-xs text-ink-500">
            编号过程笔记，记录进行中的研究，非定稿。发出去的不回改，勘误写在下一篇。
          </p>
        )
      }
      <h1 class="text-3xl font-semibold leading-snug text-ink-100 sm:text-4xl">{title}</h1>
      {!isNotebook && <p class="ui-meta mt-3">{byline}</p>}
      {
        isNotebook ? (
          <p class="mt-4 text-lg leading-relaxed text-ink-400">{description}</p>
        ) : (
          <div class="mt-6">
            <p class="ui-section-label">摘要</p>
            <p class="text-lg leading-relaxed text-ink-400">{description}</p>
          </div>
        )
      }
      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {tags.map((t) => (
              <li class="ui-tag">#{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    {/* TOC 只给定稿档；条目 <3 时组件自身不渲染 */}
    {!isNotebook && <Toc headings={headings} />}

    <div class="prose-site">
      <slot />
    </div>

    <footer class="mt-16 space-y-8 border-t border-surface-800 pt-8">
      {/* 招募段：全档 */}
      <section>
        <p class="ui-section-label">如果你也在想这个问题</p>
        <p class="text-sm leading-relaxed text-ink-400">
          这篇内容的反馈、反驳、延伸讨论，都欢迎写信来聊。
          <a href={mailtoHref} class="text-ink-200 underline decoration-ink-500 underline-offset-2 transition-colors hover:text-ink-100 hover:decoration-ink-300">
            {profile.email}
          </a>
        </p>
      </section>

      {/* 请这样引用：仅定稿档 */}
      {
        !isNotebook && (
          <section>
            <p class="ui-section-label">请这样引用</p>
            <p class="rounded-lg border border-surface-800 bg-surface-900 px-4 py-3 font-mono text-xs leading-relaxed text-ink-400">
              {citation}
            </p>
          </section>
        )
      }

      {/* 这一页如何长成：frontmatter history: true 且 git 史可读时 */}
      {commits.length > 0 && <PageHistory commits={commits} />}

      {/* 前后篇导航：仅 notebook，且至少有一侧 */}
      {
        isNotebook && (prev || next) && (
          <nav class="flex items-baseline justify-between gap-4 text-sm" aria-label="前后篇">
            <span>
              {prev && (
                <a
                  href={`/stories/${prev.id}`}
                  class="ui-link"
                >
                  ← 笔记 #{formatSeq(prev.seq)} {prev.title}
                </a>
              )}
            </span>
            <span class="text-right">
              {next && (
                <a
                  href={`/stories/${next.id}`}
                  class="ui-link"
                >
                  笔记 #{formatSeq(next.seq)} {next.title} →
                </a>
              )}
            </span>
          </nav>
        )
      }

      <a href="/stories" class="ui-link-subtle block">
        ← 返回全部故事
      </a>
    </footer>
  </article>
</Base>

<style>
  .progress-track {
    position: fixed;
    inset: 3.5rem 0 auto 0; /* below the 14 (3.5rem) nav */
    height: 2px;
    z-index: 40;
    background: transparent;
  }
  .progress-thumb {
    height: 100%;
    background: var(--color-ink-500);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    .progress-thumb {
      animation: grow linear both;
      animation-timeline: scroll(root);
    }
    @keyframes grow {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }
</style>
