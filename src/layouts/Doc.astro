---
import BookmarkButton from '@/components/shell/BookmarkButton.svelte';
import ReadingProgress from '@/components/shell/ReadingProgress.svelte';
import ArticleComments from '@/components/shell/ArticleComments.svelte';
import I18n from '@/components/shell/I18n.astro';
import Bi from '@/components/shell/Bi.astro';
import DateText from '@/components/shell/DateText.astro';
import TagList from '@/components/shell/TagList.astro';
import CopyUrl from '@/components/shell/CopyUrl.svelte';
import SeriesNav from '@/components/shell/SeriesNav.astro';
import { docHref, isTranslation, languageVersions, seriesContext, type DocEntry } from '@/lib/docs';
import { canonicalUrl as pageCanonical, languageSwitchHref } from '@/lib/hosts';
import { t } from '@/lib/i18n';
import { localizeHref } from '@/lib/locale';
import { docJsonLd } from '@/lib/agent';
import { DOC_TITLE_ID } from '@/lib/toc';

interface Props {
  doc: DocEntry;
  preview?: boolean;
}

const { doc, preview = false } = Astro.props;
const {
  slot,
  title,
  description,
  date,
  updated,
  tags,
  stack,
  repo,
  homepage,
  downloads,
  screenshots,
} = doc.data;
const isArticle = slot === 'article';
const slug = doc.id;
const uiLang = Astro.locals.lang === 'en' ? 'en' : 'zh-CN';
const summary = description.trim();
const address = docHref(doc);

/** Same kind names as the dashboard 属性 block. Published values only: no review diff. */
function articleTypeName(entry: DocEntry): string {
  if (isTranslation(entry)) {
    return entry.data.language ? `Translation · ${entry.data.language}` : 'Translation';
  }
  switch (entry.data.heptabaseType) {
    case 'reference':
      return 'Reference';
    case 'project':
      return 'Project';
    case 'page':
      return 'Page';
    default:
      return 'Article';
  }
}
const typeName = articleTypeName(doc);
const canonicalUrl = pageCanonical(
  Astro.locals.localePath?.(Astro.url.pathname) ?? localizeHref(Astro.url.pathname, Astro.locals.locale),
);
const series = isArticle && !preview ? await seriesContext(doc) : null;
const translation = isTranslation(doc);
const versions = !preview && (isArticle || slot === 'project') ? await languageVersions(doc) : [];
const jsonLd = docJsonLd(doc);
---

{!preview && <script is:inline type="application/ld+json" set:html={jsonLd} />}

{isArticle && !preview && <ReadingProgress client:load slug={slug} />}

<div class="article-shell relative px-4 pt-8 pb-14 sm:px-6" id={preview ? undefined : DOC_TITLE_ID}>
  <header class="article-lede">
    {
      isArticle && (
        <div class="article-lede-tools mb-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-3">
            {updated && (
              <span class="ui-meta">
                <I18n k="updatedPrefix" />{' '}
                <DateText date={updated} />
              </span>
            )}
          </div>
          <div class="flex items-center gap-3">
            {versions.map((version) => (
              <a
                href={languageSwitchHref(version.lang, version.href)}
                hreflang={version.lang === 'zh' ? 'zh-CN' : 'en'}
                lang={version.lang === 'zh' ? 'zh-CN' : 'en'}
                class="ui-meta ui-link"
                data-language-switch={version.lang}
              >
                {version.label}
              </a>
            ))}
            {!preview && <BookmarkButton client:load slug={slug} />}
          </div>
        </div>
      )
    }
    {
      !isArticle && versions.length > 0 && (
        <div class="mb-4 flex flex-wrap items-center gap-3">
          {versions.map((version) => (
            <a
              href={languageSwitchHref(version.lang, version.href)}
              hreflang={version.lang === 'zh' ? 'zh-CN' : 'en'}
              lang={version.lang === 'zh' ? 'zh-CN' : 'en'}
              class="ui-meta ui-link"
              data-language-switch={version.lang}
            >
              {version.label}
            </a>
          ))}
        </div>
      )
    }
    <h1 class="text-3xl font-semibold leading-snug text-ink-100 sm:text-4xl">
      <Bi zh={title} />
    </h1>
    {series && <SeriesNav series={series} part="parent" />}
  </header>

  {!preview && <CopyUrl client:visible url={canonicalUrl} lang={Astro.locals.lang === 'en' ? 'en' : 'zh-CN'} />}

  <div class="article-body-row relative mt-8">
    <article class="article-page">
      <header class="article-dek">
        {
          (isArticle || (slot === 'project' && translation)) && (
            <section class="article-meta" aria-label={t(uiLang, 'metaProperties')}>
              <p class="article-meta-label"><I18n k="metaProperties" /></p>
              <dl class="article-meta-grid">
                <dt><I18n k="metaType" /></dt>
                <dd>{typeName}</dd>
                <dt><I18n k="metaAddress" /></dt>
                <dd><code>{address}</code></dd>
                {
                  date && (
                    <>
                      <dt><I18n k="metaDate" /></dt>
                      <dd>
                        <time datetime={date.toISOString()}>
                          <DateText date={date} />
                        </time>
                      </dd>
                    </>
                  )
                }
                {
                  tags.length > 0 && (
                    <>
                      <dt><I18n k="tagsTitle" /></dt>
                      <dd><TagList tags={tags} class="ui-tag-list--start" /></dd>
                    </>
                  )
                }
              </dl>
            </section>
          )
        }
        {
          summary ? (
            <p class="article-dek-text">
              <Bi zh={description} />
            </p>
          ) : null
        }
        {
          !isArticle && stack.length > 0 && (
            <dl class="article-meta">
              <dt><I18n k="techStack" /></dt>
              <dd>
                <ul class="ui-tag-list ui-tag-list--start">
                  {stack.map((item) => (
                    <li class="ui-tag">{item}</li>
                  ))}
                </ul>
              </dd>
            </dl>
          )
        }
      </header>

      {
        screenshots.length > 0 && (
          <div class="mb-10 grid gap-4 sm:grid-cols-2">
            {screenshots.map((s) => (
              <img src={s.src} alt={s.alt} loading="lazy" />
            ))}
          </div>
        )
      }

      <div class="article-main">
        <div class="prose-site">
          <slot />
        </div>

        <footer class="mt-16 space-y-8 pt-8">
          {
            !isArticle && (repo || homepage) && (
              <div class="flex flex-col gap-3">
                {homepage && (
                  <a
                    href={homepage}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-ink-200 underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100"
                  >
                    <I18n k="visitSite" />
                  </a>
                )}
                {repo && (
                  <a
                    href={repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-ink-400 underline decoration-ink-600 underline-offset-4 transition-colors hover:text-ink-100"
                  >
                    <I18n k="githubRepo" />
                  </a>
                )}
              </div>
            )
          }
          {
            !isArticle && downloads.length > 0 && (
              <ul class="flex flex-col gap-2">
                {downloads.map((d) => (
                  <li>
                    <a
                      href={d.url}
                      class="flex items-center justify-between text-sm text-ink-200 transition-colors hover:text-ink-100"
                    >
                      <span>{d.label}</span>
                      {d.platform && <span class="ui-meta">{d.platform}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
          {series && <SeriesNav series={series} part="pager" />}
          {isArticle && !preview && !translation && <ArticleComments client:visible slug={slug} />}
        </footer>
      </div>
    </article>
  </div>
</div>
