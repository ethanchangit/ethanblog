---
import BookmarkButton from '@/components/shell/BookmarkButton.svelte';
import ReadingProgress from '@/components/shell/ReadingProgress.svelte';
import ArticleComments from '@/components/shell/ArticleComments.svelte';
import { getSession } from '@/lib/auth';
import { listComments } from '@/lib/db';
import type { ArticleComment } from '@/lib/comments';
import { isSiteOwner } from '@/lib/user';
import I18n from '@/components/shell/I18n.astro';
import Bi from '@/components/shell/Bi.astro';
import DateText from '@/components/shell/DateText.astro';
import TagList from '@/components/shell/TagList.astro';
import CopyUrl from '@/components/shell/CopyUrl.svelte';
import SeriesNav from '@/components/shell/SeriesNav.astro';
import { site } from '@/data/profile';
import { seriesContext, type DocEntry } from '@/lib/docs';

interface Props {
  doc: DocEntry;
}

const { doc } = Astro.props;
const {
  slot,
  title,
  titleEn,
  description,
  descriptionEn,
  date,
  updated,
  tags,
  stack,
  repo,
  homepage,
  downloads,
  screenshots,
} = doc.data;
const isArticle = slot === 'article';
const slug = doc.id;
const canonicalUrl = new URL(Astro.url.pathname, site.url).href;
const series = isArticle ? await seriesContext(doc) : null;

let initialComments: ArticleComment[] = [];
if (isArticle) {
  try {
    const env = Astro.locals.runtime?.env;
    const db = env?.DB;
    if (db) {
      let includePrivate = false;
      if (env) {
        try {
          const session = await getSession(Astro.request, env);
          includePrivate = isSiteOwner(session?.user);
        } catch {
          includePrivate = false;
        }
      }
      initialComments = await listComments(db, slug, { includePrivate });
    }
  } catch {
    initialComments = [];
  }
}
---

{isArticle && <ReadingProgress client:load slug={slug} />}

<div class="article-shell relative mx-auto max-w-2xl px-4 pt-8 pb-14 sm:px-6">
  <header class="article-lede">
    {
      isArticle && date && (
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-3">
            <time datetime={date.toISOString()} class="ui-meta">
              <DateText date={date} />
            </time>
            {updated && (
              <span class="ui-meta">
                <I18n k="updatedPrefix" />{' '}
                <DateText date={updated} />
              </span>
            )}
          </div>
          <BookmarkButton client:load slug={slug} />
        </div>
      )
    }
    <h1 class="text-3xl font-semibold leading-snug text-ink-100 sm:text-4xl">
      <Bi zh={title} en={titleEn} />
    </h1>
    {series && <SeriesNav series={series} part="parent" />}
  </header>

  <CopyUrl client:visible url={canonicalUrl} />

  <div class="article-body-row relative mt-8">
    <article class="article-page">
      <header class="article-dek">
        <p class="article-dek-text">
          <Bi zh={description} en={descriptionEn} />
        </p>
        {isArticle ? (
          <TagList tags={tags} />
        ) : (
          stack.length > 0 && (
            <ul class="ui-tag-list mt-5">
              {stack.map((item) => (
                <li class="ui-tag">{item}</li>
              ))}
            </ul>
          )
        )}
      </header>

      {
        screenshots.length > 0 && (
          <div class="mb-10 grid gap-4 sm:grid-cols-2">
            {screenshots.map((s) => (
              <img src={s.src} alt={s.alt} loading="lazy" />
            ))}
          </div>
        )
      }

      <div class="article-main">
        <div class="prose-site">
          <slot />
        </div>

        {series && <SeriesNav series={series} part="chapters" />}

        <footer class="mt-16 space-y-8 pt-8">
          {
            !isArticle && (repo || homepage) && (
              <div class="flex flex-col gap-3">
                {homepage && (
                  <a
                    href={homepage}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-ink-200 underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100"
                  >
                    <I18n k="visitSite" />
                  </a>
                )}
                {repo && (
                  <a
                    href={repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-ink-400 underline decoration-ink-600 underline-offset-4 transition-colors hover:text-ink-100"
                  >
                    <I18n k="githubRepo" />
                  </a>
                )}
              </div>
            )
          }
          {
            !isArticle && downloads.length > 0 && (
              <ul class="flex flex-col gap-2">
                {downloads.map((d) => (
                  <li>
                    <a
                      href={d.url}
                      class="flex items-center justify-between text-sm text-ink-200 transition-colors hover:text-ink-100"
                    >
                      <span>{d.label}</span>
                      {d.platform && <span class="ui-meta">{d.platform}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
          {series && <SeriesNav series={series} part="pager" />}
          {isArticle && <ArticleComments client:visible slug={slug} comments={initialComments} />}
        </footer>
      </div>
    </article>
  </div>
</div>
