---
import { getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { copy } from '@/lib/i18n';

const contact = await getEntry('pages', 'contact');
if (!contact) return new Response(null, { status: 404 });
const { Content } = await render(contact);
---

<Base
  title={contact.data.title || copy.en.contactPageTitle}
  description={contact.data.description}
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 prose-site">
    <Content />
  </article>
</Base>
