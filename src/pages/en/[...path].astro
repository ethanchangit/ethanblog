---
// English translations (#blogi18n), built under /en and served on ethanchang.io at the
// same path as their Chinese source. Missing translations are not generated, so the
// English host sends the reader to that path on the Chinese site.
import ArticleView from '@/components/shell/ArticleView.astro';
import ReadingShell from '@/components/shell/ReadingShell.astro';
import TagsIndex from '@/components/shell/TagsIndex.astro';
import TranslatedPage from '@/components/shell/TranslatedPage.astro';
import { copy } from '@/lib/i18n';
import {
  docHref,
  englishArticles,
  englishPages,
  englishProjects,
  includeDraftsInDev,
  sitePageHref,
  translationSourceId,
  type DocEntry,
} from '@/lib/docs';
import { FIXED_PAGE_IDS, reservedPathSegment, TAGS_PATH } from '@/lib/routes';
import { publishedArticles, uniqueTags } from '@/lib/tags';
import type { CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const opts = { includeDrafts: includeDraftsInDev };
  const [articles, projects, pages] = await Promise.all([
    englishArticles(opts),
    englishProjects(opts),
    englishPages(opts),
  ]);
  const paths: {
    params: { path: string };
    props: { kind: 'doc' | 'projects' | 'page' | 'tags' | 'tag'; entry?: DocEntry | CollectionEntry<'pages'>; tag?: string };
  }[] = [];
  const owners = new Map<string, string>();
  const claim = (path: string, label: string, allowFixed = false) => {
    const reserved = reservedPathSegment(`/${path}`);
    if (reserved && !(allowFixed && FIXED_PAGE_IDS.has(reserved))) {
      throw new Error(`「${label}」的地址 /${path} 与网站固定地址 /${reserved} 冲突。`);
    }
    const previous = owners.get(path);
    if (previous) throw new Error(`地址 /${path} 同时被「${previous}」和「${label}」使用。`);
    owners.set(path, label);
  };
  for (const article of articles) {
    const href = docHref(article);
    if (href === '/') continue;
    claim(href.slice(1), article.data.title);
    paths.push({ params: { path: href.slice(1) }, props: { kind: 'doc', entry: article } });
  }
  for (const project of projects) {
    const path = docHref(project).slice(1);
    claim(path, project.data.title);
    paths.push({ params: { path }, props: { kind: 'doc', entry: project } });
  }
  if (projects.length) paths.push({ params: { path: 'projects' }, props: { kind: 'projects' } });
  // /tags is a site index, not a #blogi18n card. The English host rewrites /tags here.
  paths.push({ params: { path: 'tags' }, props: { kind: 'tags' } });
  for (const tag of uniqueTags(await publishedArticles())) {
    paths.push({ params: { path: `tags/${tag}` }, props: { kind: 'tag', tag } });
  }
  for (const page of pages) {
    const href = sitePageHref(page.id);
    if (href === '/') continue;
    claim(href.slice(1), page.data.title, FIXED_PAGE_IDS.has(translationSourceId(page.id)));
    paths.push({ params: { path: href.slice(1) }, props: { kind: 'page', entry: page } });
  }
  return paths;
}

const { kind, entry, tag = '' } = Astro.props;
const doc = kind === 'doc' ? (entry as DocEntry) : undefined;
const page = kind === 'page' ? (entry as CollectionEntry<'pages'>) : undefined;
const tagDest = Astro.locals.localePath(`${TAGS_PATH}?tag=${encodeURIComponent(tag)}`);
---

{kind === 'projects' && (
  <ReadingShell kind="index" indexList="projects" title={copy.en.projectsTitle} description={copy.en.projectsDesc} />
)}
{kind === 'tags' && <TagsIndex />}
{kind === 'tag' && (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta http-equiv="refresh" content={`0;url=${tagDest}`} />
      <link rel="canonical" href={tagDest} />
      <title>Redirecting</title>
      <script is:inline define:vars={{ tagDest }}>
        location.replace(tagDest);
      </script>
    </head>
    <body>
      <p><a href={tagDest}>Continue</a></p>
    </body>
  </html>
)}
{doc && <ArticleView article={doc} />}
{page && <TranslatedPage page={page} />}
