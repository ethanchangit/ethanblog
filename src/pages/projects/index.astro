---
import Base from '@/layouts/Base.astro';
import Timeline from '@/components/media/Timeline.svelte';
import Card from '@/components/shell/Card.astro';
import I18n from '@/components/shell/I18n.astro';
import Bi from '@/components/shell/Bi.astro';
import { getCollection } from 'astro:content';
import { statusLabel } from '@/lib/format';
import { lineageEdges, lineageTimeline } from '@/data/projects-lineage';
import { copy } from '@/lib/i18n';
import { projectHref } from '@/lib/routes';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const bySlug = Object.fromEntries(projects.map((p) => [p.id, p]));
---

<Base
  title={copy['zh-CN'].projectsTitle}
  titleEn={copy.en.projectsTitle}
  description={copy['zh-CN'].projectsDesc}
  descriptionEn={copy.en.projectsDesc}
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <p class="ui-eyebrow">Projects</p>
      <h1 class="text-3xl font-semibold tracking-tight text-ink-100 sm:text-4xl">
        <I18n k="projectsH1" />
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-400">
        <I18n k="projectsLead" />
      </p>
    </header>

    <div class="prose-site">
      <h2 id="lineage"><I18n k="projectsLineageH2" /></h2>

      <p>
        <I18n k="projectsLineageP" />
      </p>

      <Timeline
        client:visible
        items={[...lineageTimeline]}
        caption="按叙事顺序排列，不等于立项先后。有些项目并行酝酿，但能力继承的方向是清晰的。"
        captionEn="Narrative order, not founding order. Some projects were brewing in parallel; the direction of inheritance is still clear."
      />

      <p><I18n k="projectsEdgesIntro" /></p>

      <ul>
        {
          lineageEdges.map((edge) => (
            <li>
              <a href={projectHref(edge.from)}>
                {bySlug[edge.from]?.data.name ?? edge.from}
              </a>
              {' → '}
              <a href={projectHref(edge.to)}>{bySlug[edge.to]?.data.name ?? edge.to}</a>
              {'：'}
              <Bi zh={edge.carries} en={edge.carriesEn} />
            </li>
          ))
        }
      </ul>

      <h2 id="archive"><I18n k="projectsArchiveH2" /></h2>

      <p><I18n k="projectsArchiveP" /></p>
    </div>

    <div class="flex flex-col">
      {
        projects.map((p) => {
          const badge = statusLabel[p.data.status];
          return (
            <Card
              href={projectHref(p.id)}
              title={p.data.name}
              titleEn={p.data.nameEn}
              description={p.data.tagline}
              descriptionEn={p.data.taglineEn}
              meta={badge.text}
              metaEn={badge.textEn}
            />
          );
        })
      }
    </div>
  </article>
</Base>
