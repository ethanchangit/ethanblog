---
import { docHref, docsBySlot, includeDraftsInDev } from '@/lib/docs';

export const prerender = import.meta.env.PROD;

// 旧地址 /projects/<id> 转到 /<slug>。/projects 列表仍由 index 提供。
export async function getStaticPaths() {
  const projects = await docsBySlot('project', { includeDrafts: includeDraftsInDev });
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { target: docHref(project) },
  }));
}

const target = Astro.props.target as string | undefined;
if (!target) return Astro.rewrite('/404');
return Astro.redirect(target, 301);
---
