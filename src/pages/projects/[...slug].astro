---
import ReadingShell from '@/components/shell/ReadingShell.astro';
import Doc from '@/layouts/Doc.astro';
import Toc from '@/components/shell/Toc.astro';
import { docsBySlot, findDoc, includeDraftsInDev } from '@/lib/docs';
import { hasToc } from '@/lib/toc';
import { render } from 'astro:content';

export const prerender = import.meta.env.PROD;

export async function getStaticPaths() {
  const projects = await docsBySlot('project', { includeDrafts: includeDraftsInDev });
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const slug = Astro.params.slug ?? '';
const project =
  Astro.props.project ??
  (await findDoc('projects', slug, { includeDrafts: includeDraftsInDev }));
if (!project) {
  return Astro.rewrite('/404');
}
const { Content, headings, remarkPluginFrontmatter } = await render(project);
const split = remarkPluginFrontmatter.i18nHeadingSplit as number | undefined;
const zhHeadings = typeof split === 'number' ? headings.slice(0, split) : headings;
const enHeadings = typeof split === 'number' ? headings.slice(split) : [];
const showRail = hasToc(zhHeadings);
---

<ReadingShell
  kind="project"
  title={project.data.title}
  titleEn={project.data.titleEn}
  description={project.data.description}
  descriptionEn={project.data.descriptionEn ?? project.data.description}
  currentId={project.id}
  showRail={showRail}
>
  <Doc doc={project}>
    <Content />
  </Doc>
  <Fragment slot="rail">
    <Toc headings={zhHeadings} headingsEn={enHeadings} />
  </Fragment>
</ReadingShell>
