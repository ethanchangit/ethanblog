---
import { getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { copy } from '@/lib/i18n';

const privacy = await getEntry('pages', 'privacy');
if (!privacy) return new Response(null, { status: 404 });
const { Content } = await render(privacy);
---

<Base
  title={privacy.data.title || copy['zh-CN'].privacyTitle}
  description={privacy.data.description}
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 prose-site">
    <Content />
  </article>
</Base>
