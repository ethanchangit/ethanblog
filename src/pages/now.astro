---
import { getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import DateText from '@/components/shell/DateText.astro';
import I18n from '@/components/shell/I18n.astro';
import { copy } from '@/lib/i18n';

const now = await getEntry('pages', 'now');
if (!now) return new Response(null, { status: 404 });
const { Content } = await render(now);
const stamp = now.data.updated ?? now.data.date;
const updated = stamp ? new Date(stamp.getUTCFullYear(), stamp.getUTCMonth(), stamp.getUTCDate()) : null;
---

<Base
  title={copy.en.navNow}
  description={now.data.description}
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight text-ink-100 sm:text-4xl">
        <I18n k="navNow" />
      </h1>
      {updated && <p class="ui-meta mt-3"><I18n k="nowUpdated" /> <DateText date={updated} /></p>}
    </header>

    <div class="prose-site">
      <Content />
    </div>
  </article>
</Base>
