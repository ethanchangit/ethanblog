---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';

export async function getStaticPaths() {
  const reserved = new Set(['blogs', 'about', 'now', 'contact', 'privacy']);
  const pages = await getCollection('pages', ({ id, data }) => !reserved.has(id) && !data.draft);
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
if (!page) return new Response(null, { status: 404 });
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 prose-site">
    <h1 class="text-3xl font-semibold leading-snug text-ink-100 sm:text-4xl">{page.data.title}</h1>
    <Content />
  </article>
</Base>
