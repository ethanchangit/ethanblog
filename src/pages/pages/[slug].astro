---
import { getCollection } from 'astro:content';
import { includeDraftsInDev } from '@/lib/docs';
import { FIXED_PAGE_IDS, sitePageHref } from '@/lib/routes';

export const prerender = import.meta.env.PROD;

// 旧地址 /pages/<id> 转到 /<id>。关于、Now、联系、隐私和博客目录不从这里生成。
export async function getStaticPaths() {
  const pages = await getCollection(
    'pages',
    ({ id, data }) => !data.translationOf && !FIXED_PAGE_IDS.has(id) && (includeDraftsInDev || !data.draft),
  );
  return pages.map((page) => ({ params: { slug: page.id }, props: { target: sitePageHref(page.id) } }));
}

const slug = Astro.params.slug ?? '';
const target = (Astro.props.target as string | undefined) ?? (slug ? sitePageHref(slug) : '');
if (!target || FIXED_PAGE_IDS.has(slug)) return Astro.rewrite('/404');
return Astro.redirect(target, 301);
---
