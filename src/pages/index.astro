---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.svelte';
import SkillsGraph from '@/components/home/SkillsGraph.svelte';
import NowPanel from '@/components/home/NowPanel.astro';
import SectionHeading from '@/components/shell/SectionHeading.astro';
import I18n from '@/components/shell/I18n.astro';
import { profile, skills } from '@/data/profile';
---

<Base>
  <Hero client:load name={profile.name} />

  <div class="mx-auto flex max-w-5xl flex-col gap-20 px-4 pb-24 sm:px-6">
    <section data-i18n-aria="nowAria" aria-label="正在进行">
      <NowPanel />
    </section>

    <section data-i18n-aria="skillsAria" aria-label="技能">
      <SectionHeading eyebrow="Skills" titleKey="skillsTitle" />
      <SkillsGraph client:visible skills={skills} />
    </section>

    <section data-i18n-aria="contactAria" aria-label="联系" class="py-4 text-center">
      <h2 class="text-xl font-semibold text-ink-100"><I18n k="contactTitle" /></h2>
      <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-ink-500">
        <I18n k="contactBody" />
      </p>
      <p class="mt-6 text-sm">
        <a
          href={`mailto:${profile.email}`}
          class="text-ink-200 underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100 hover:decoration-ink-300"
        >
          {profile.email}
        </a>
      </p>
    </section>
  </div>
</Base>
