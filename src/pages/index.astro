---
import Base from '@/layouts/Base.astro';
import { profile } from '@/data/profile';
---

<Base>
  <section class="mx-auto max-w-5xl px-4 py-24 sm:px-6">
    <h1 class="text-4xl font-semibold text-ink-100">{profile.name}</h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink-400">{profile.bio}</p>
  </section>
</Base>
