---
import Base from '@/layouts/Base.astro';
import Card from '@/components/shell/Card.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '@/lib/format';
import { getThread } from '@/data/threads';

const stories = (await getCollection('stories', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="故事" description="互动故事与文章 —— 用最合适的媒介档位，讲每一个故事。">
  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <p class="ui-eyebrow">Stories</p>
      <h1 class="text-3xl font-semibold text-ink-100">故事</h1>
      <p class="mt-3 max-w-xl text-ink-400">
        有些故事一段文字就够了，有些故事值得你亲手把玩。带
        <span class="ui-badge ui-badge--active mx-1">互动故事</span>
        徽章的页面里藏着可以动手的东西。
      </p>
    </header>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        stories.map((s) => (
          <Card
            href={`/stories/${s.id}`}
            title={s.data.title}
            description={s.data.description}
            meta={
              s.data.kind === 'notebook'
                ? `${getThread(s.data.thread)?.title ?? s.data.thread} · #${String(s.data.seq ?? 0).padStart(2, '0')} · ${formatDate(s.data.date)}`
                : formatDate(s.data.date)
            }
            badge={
              s.data.kind === 'interactive'
                ? { text: '互动故事', accent: true }
                : s.data.kind === 'notebook'
                  ? { text: '研究笔记' }
                  : { text: '文章' }
            }
            tags={s.data.tags}
          />
        ))
      }
    </div>
  </section>
</Base>
