---
import Story from '@/layouts/Story.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

interface Props {
  story: CollectionEntry<'stories'>;
}

const { story } = Astro.props;
const { Content, headings } = await render(story);

// notebook 档：同一研究线内按 seq 排序，算前后篇
let prev: { id: string; title: string; seq: number } | undefined;
let next: { id: string; title: string; seq: number } | undefined;
if (story.data.kind === 'notebook' && story.data.thread) {
  const siblings = (
    await getCollection(
      'stories',
      ({ data }) => !data.draft && data.kind === 'notebook' && data.thread === story.data.thread
    )
  ).sort((a, b) => (a.data.seq ?? 0) - (b.data.seq ?? 0));
  const i = siblings.findIndex((s) => s.id === story.id);
  const toNav = (s: CollectionEntry<'stories'> | undefined) =>
    s ? { id: s.id, title: s.data.title, seq: s.data.seq ?? 0 } : undefined;
  prev = toNav(siblings[i - 1]);
  next = toNav(siblings[i + 1]);
}
---

<Story story={story} headings={headings} prev={prev} next={next}>
  <Content />
</Story>
