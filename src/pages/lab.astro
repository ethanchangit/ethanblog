---
/**
 * 组件试验场 —— 媒介组件库的常驻 QA 页。
 * 每个组件在这里都有一个最小可用示例；新组件先在这里点亮再进故事。
 */
import Base from '@/layouts/Base.astro';
import {
  ParamSlider,
  BeforeAfterSlider,
  ScrollScene,
  Timeline,
  StatCounter,
  AudioClip,
  InteractiveDemo,
  ImageGallery,
  VideoEmbed,
  TweetEmbed,
  CodePlayground,
  Scene3D,
  SideNote,
  RuleGarden,
  RuleTarget,
  Var,
  Calc,
  VerdictTable,
  Mention,
  MentionTarget,
  DocList,
  DocRef,
  MediaFrame,
} from '@/components/media';
import demoPeaks from '@/data/demo-chime-peaks.json';
import I18n from '@/components/shell/I18n.astro';
---

<Base title="Lab" titleEn="Lab" description="媒介组件试验场" descriptionEn="Media component lab">
  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight text-ink-100 sm:text-4xl"><I18n k="labTitle" /></h1>
      <p class="mt-3 text-ink-400"><I18n k="labLead" /></p>
    </header>

    <h2 class="mb-2 text-xl font-semibold text-ink-100">ParamSlider</h2>
    <div data-testid="param-slider">
      <ParamSlider
        client:visible
        label="卡片数量"
        paramKey="count"
        min={10}
        max={200}
        initial={60}
        viz="network"
        caption="左边的滑块控制右边的知识网络：卡片越多，连接越密。"
      />
    </div>

    <div data-testid="param-slider-multi">
      <ParamSlider
        client:visible
        controls={[
          { key: 'freq', label: '频率', min: 1, max: 8, initial: 2 },
          { key: 'amp', label: '振幅', min: 10, max: 120, initial: 60, unit: 'px' },
        ]}
        viz="curve"
        height={240}
        caption="多参数模式：频率与振幅共同塑造波形。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">BeforeAfterSlider</h2>
    <div data-testid="before-after">
      <BeforeAfterSlider
        client:visible
        before={{ src: '/media/compare-before.svg', alt: '文字描述的山与落日（线稿）' }}
        after={{ src: '/media/compare-after.svg', alt: '亲眼所见的山与落日（彩色）' }}
        labels={['文字', '所见']}
        caption="拖动分割线：同一个故事，两种媒介档位。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">ScrollScene</h2>
    <div data-testid="scroll-scene">
      <ScrollScene
        client:visible={{ rootMargin: '150% 0px' }}
        scenes={[
          {
            title: '一切从一张卡片开始',
            text: '每个想法都是一个节点。它们彼此孤立，安静地漂浮。',
            viz: 'network',
            params: { count: 25, link: 40 },
          },
          {
            title: '链接让知识生长',
            text: '当你开始链接，节点之间出现了结构 —— 网络涌现了。',
            viz: 'network',
            params: { count: 90, link: 90 },
          },
          {
            title: '最终形成你的第二大脑',
            text: '密集链接的知识网络，会在你需要的时候把答案递到手边。',
            viz: 'network',
            params: { count: 170, link: 120 },
          },
        ]}
        caption="滚动推进故事：可视化随场景平滑演变。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">Timeline</h2>
    <div data-testid="timeline">
      <Timeline
        client:visible
        items={[
          { date: '2024', title: '第一行 Swift', body: '从 UIKit 起步，爱上原生开发的手感。', icon: '🌱' },
          { date: '2025', title: 'Robert 立项', body: '语音优先的笔记应用开始动工。', icon: '🎙️' },
          { date: '2026', title: '这个网站诞生', body: '从博客到超媒体容器。', icon: '🚀' },
        ]}
        caption="时间线组件：节点随滚动渐入。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">StatCounter</h2>
    <div data-testid="stat-counter">
      <StatCounter
        client:visible
        stats={[
          { value: 7, label: '进行中的项目' },
          { value: 1200, label: '知识卡片', suffix: '+' },
          { value: 3, label: '媒介档位' },
          { value: 100, label: '折腾指数', suffix: '%' },
        ]}
        caption="数字滚动计数：进入视野时从 0 数到终值。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">AudioClip</h2>
    <div data-testid="audio-clip">
      <AudioClip
        client:visible
        src="/media/demo-chime.wav"
        title="演示音频 · 合成琶音"
        peaks={demoPeaks}
        caption="自绘波形播放器：点击波形跳转进度。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">InteractiveDemo</h2>
    <div data-testid="interactive-demo">
      <InteractiveDemo
        client:visible
        src="/demos/knowledge-garden/"
        title="知识花园 · knowledge-garden"
        poster="/media/posters/knowledge-garden.svg"
        posterAlt="知识花园预览：深色背景上的知识网络"
        caption="沙箱中运行的真实小软件：点击画布种下想法。未加载时先展示 poster 预览。"
      />
    </div>

    <div data-testid="interactive-demo-robert" class="mt-6">
      <InteractiveDemo
        client:visible
        src="/demos/robert/"
        title="Robert · 语音笔记"
        height="520px"
        caption="语音录制 UI + 转写后的块级卡片。"
      />
    </div>

    <div data-testid="interactive-demo-network" class="mt-6">
      <InteractiveDemo
        client:visible
        src="/demos/network/"
        title="Network · 键盘笔记"
        height="480px"
        caption="键盘导航卡片网格，Enter 进入 Markdown 编辑。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">ImageGallery</h2>
    <div data-testid="image-gallery">
      <ImageGallery
        client:visible
        columns={3}
        images={[
          { src: '/media/compare-before.svg', alt: '线稿山景', caption: '文字档' },
          { src: '/media/compare-after.svg', alt: '彩色山景', caption: '图像档' },
          { src: '/og-default.svg', alt: '站点默认 OG 图', caption: '封面' },
        ]}
        caption="点击图片打开灯箱：Escape 关闭，方向键切换。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">VideoEmbed</h2>
    <div data-testid="video-embed">
      <VideoEmbed
        provider="youtube"
        id="jNQXAC9IVRw"
        title="Me at the zoo（示例视频）"
        caption="封面点击后加载官方播放器；播放器被拦时可去 YouTube。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">TweetEmbed</h2>
    <div data-testid="tweet-embed">
      <TweetEmbed
        url="https://x.com/jack/status/20"
        caption="自绘 X 卡片：完整正文；X 进原帖，头像与 handle 进主页。"
      />
    </div>
    <div data-testid="tweet-embed-gkx" class="mt-10">
      <TweetEmbed
        url="https://x.com/gkxspace/status/2089292652940333288"
        caption="长帖完整展开；视频在页内播放，不跳转。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">CodePlayground</h2>
    <div data-testid="code-playground">
      <CodePlayground
        title="hello.js"
        lang="javascript"
        template="vanilla"
        code={`const medium = ['文字', '图片', '视频', '软件'];\nconsole.log(medium.at(-1) + ' 是最高档位的媒介');\n\ndocument.body.innerHTML = '<p style="font-family:system-ui;padding:1rem;color:#22d3ee">' + medium.at(-1) + ' 是最高档位的媒介</p>';`}
        caption="Sandpack 沙箱：点击 Run 在 iframe 中执行代码。无 JS 时降级为只读代码块。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">Scene3D</h2>
    <div data-testid="scene-3d">
      <Scene3D
        client:visible
        scene="globe"
        height={300}
        caption="three.js 岛屿：线框地球，颜色来自设计 token。关闭动效时静态渲染。"
      />
    </div>

    <div data-testid="scene-3d-particles" class="mt-8">
      <Scene3D
        client:visible
        scene="particles"
        height={240}
        caption="粒子场场景：900 个粒子缓慢旋转。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">SideNote</h2>
    <div data-testid="side-note">
      <p class="text-ink-300 leading-loose">
        旁注是正文的余光：它不打断论证，只在页边补一句。下面这段文字旁边挂着一条旁注——
        宽屏（≥1536px）时它悬挂在右页边，窄屏时回落为正文内的插注块。
      </p>
      <SideNote label="旁注">
        这就是一条旁注。它来自 Ink &amp; Switch 的版式语言：零 JS，纯 CSS 双形态。
      </SideNote>
      <p class="text-ink-300 leading-loose">
        旁注的纪律写在创作规范里：每屏至多一条，只放"离题但增味"的内容。
        能进正文的话就不该做成旁注。
      </p>
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">反应式散文 Var + Calc</h2>
    <div data-testid="reactive-prose">
      <p class="text-ink-300 leading-loose">
        正文里的数字可以拖：假设我每天读
        <Var client:visible name="cards" min={1} max={50} initial={10} unit=" 张卡片" label="每天阅读的卡片数" />，
        一年就是
        <Calc client:visible expr="cards * 365" unit=" 张" />，
        写满一个千卡片库要
        <Calc client:visible expr="ceil(1000 / cards)" unit=" 天" />。
        左右拖动下划线数字（或聚焦后按方向键），后面两个结果立即重算——
        黑色是你的手，青色是机器的推导。
      </p>
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">VerdictTable</h2>
    <div data-testid="verdict-table">
      <VerdictTable
        title="媒介档位 × 设计原则"
        corner="媒介"
        columns={['亲手操作', '无 JS 降级', '实现成本']}
        rows={[
          {
            label: '纯文字',
            cells: ['no', 'yes', { verdict: 'yes', note: '零成本', bar: 100 }],
          },
          {
            label: '交互组件',
            cells: [
              'yes',
              { verdict: 'partial', note: '降级为静态内容' },
              { verdict: 'partial', bar: 55 },
            ],
          },
          {
            label: '规则引擎',
            cells: ['yes', { verdict: 'partial', note: '降级为散文描述' }, { verdict: 'no', bar: 20 }],
          },
        ]}
        caption="裁决表：把「多方案 × 多维度」的论证变成可扫读的评分矩阵。"
      />
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">DocRef</h2>
    <div data-testid="doc-ref">
      <p class="mb-4 text-ink-300 leading-loose">
        合集文里引用一篇已有文章或项目，渲染成与索引相同的一行。
      </p>
      <DocList>
        <DocRef of="articles/series-demo/1" />
        <DocRef of="articles/pkm-method" />
        <DocRef of="projects/aletheia" />
      </DocList>
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">Mention + MentionTarget</h2>
    <div data-testid="mention">
      <p class="text-ink-300 leading-loose">
        正文里的<Mention target="lab-mountain">这张山景图</Mention>与下方的媒介块互相印证：
        悬停或聚焦任一侧，两侧同时点亮；点击词语会把图滚进视野。
      </p>
      <MentionTarget id="lab-mountain">
        <MediaFrame caption="Mention 的落点：被正文词语引用的媒介块。">
          <img src="/media/compare-after.svg" alt="彩色山景" class="w-full" />
        </MediaFrame>
      </MentionTarget>
    </div>

    <h2 class="mb-2 mt-12 text-xl font-semibold text-ink-100">RuleGarden</h2>
    <div data-testid="rule-garden">
      <p class="text-ink-300 leading-loose">
        页面即房间：下面这些物件都用 RuleTarget 声明了自己的身份。比如
        <RuleTarget name="intro-text" label="这段文字">这段文字</RuleTarget>
        ——当它进入视野或被鼠标掠过，房间里的其他物件会按规则响应。
      </p>
      <RuleTarget name="color-box" label="右侧色块" block>
        <div class="h-16 w-full text-sm leading-[4rem] text-ink-500">色块目标</div>
      </RuleTarget>
      <p class="mt-4 text-ink-300 leading-loose">
        这里还有一个计数徽标：
        <RuleTarget name="counter-badge" label="计数徽标"><span class="font-mono text-xs text-ink-400">已被点击</span></RuleTarget>
      </p>
      <RuleGarden
        title="这个页面的规则"
        rules={[
          {
            id: 'r1',
            when: { kind: 'enters-view', target: 'intro-text' },
            wish: { kind: 'tint', target: 'color-box', tone: 'accent' },
          },
          {
            id: 'r2',
            when: { kind: 'click', target: 'counter-badge' },
            wish: { kind: 'count', target: 'counter-badge' },
          },
          {
            id: 'r3',
            when: { kind: 'hover', target: 'intro-text' },
            wish: { kind: 'highlight', target: 'color-box' },
          },
        ]}
        caption="Claim/When/Wish 的网页玩具版：勾选、改词槽、加规则，页面立即响应。"
      />
    </div>
  </div>
</Base>
