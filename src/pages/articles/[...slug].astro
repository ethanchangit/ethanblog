---
import Doc from '@/layouts/Doc.astro';
import { docsBySlot } from '@/lib/docs';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await docsBySlot('article');
  return articles
    .filter((article) => !/^\d+$/.test(article.id))
    .map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(article);
const split = remarkPluginFrontmatter.i18nHeadingSplit as number | undefined;
const zhHeadings = typeof split === 'number' ? headings.slice(0, split) : headings;
const enHeadings = typeof split === 'number' ? headings.slice(split) : [];
---

<Doc doc={article} headings={zhHeadings} headingsEn={enHeadings}>
  <Content />
</Doc>
