---
import { docHref, docsBySlot, includeDraftsInDev } from '@/lib/docs';

export const prerender = import.meta.env.PROD;

// 旧地址 /articles/<id> 转到 /<slug>。纯数字留给分页（/articles/2 → /articles）。
export async function getStaticPaths() {
  const articles = await docsBySlot('article', { includeDrafts: includeDraftsInDev });
  return articles
    .filter((article) => !/^\d+$/.test(article.id))
    .map((article) => ({
      params: { slug: article.id },
      props: { target: docHref(article) },
    }));
}

const target = Astro.props.target as string | undefined;
if (!target) return Astro.rewrite('/404');
return Astro.redirect(target, 301);
---
