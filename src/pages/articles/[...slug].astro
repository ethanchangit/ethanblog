---
import ReadingShell from '@/components/shell/ReadingShell.astro';
import Doc from '@/layouts/Doc.astro';
import Toc from '@/components/shell/Toc.astro';
import { docsBySlot, findDoc, includeDraftsInDev } from '@/lib/docs';
import { hasToc } from '@/lib/toc';
import { render } from 'astro:content';

export const prerender = import.meta.env.PROD;

// 纯数字 slug 留给旧分页 URL（`/articles/2` → `/articles`），避免和文章抢路径。
export async function getStaticPaths() {
  const articles = await docsBySlot('article', { includeDrafts: includeDraftsInDev });
  return articles
    .filter((article) => !/^\d+$/.test(article.id))
    .map((article) => ({
      params: { slug: article.id },
      props: { article },
    }));
}

const slug = Astro.params.slug ?? '';
const article =
  Astro.props.article ??
  (await findDoc('articles', slug, { includeDrafts: includeDraftsInDev }));
if (!article || /^\d+$/.test(article.id)) {
  return Astro.rewrite('/404');
}
const rendered = await render(article);
const split = rendered.remarkPluginFrontmatter.i18nHeadingSplit as number | undefined;
const zhHeadings =
  typeof split === 'number' ? rendered.headings.slice(0, split) : rendered.headings;
const enHeadings = typeof split === 'number' ? rendered.headings.slice(split) : [];
const showRail = hasToc(zhHeadings);
const Content = rendered.Content;
---

<ReadingShell
  kind="article"
  title={article.data.title}
  titleEn={article.data.titleEn}
  description={article.data.description}
  descriptionEn={article.data.descriptionEn ?? article.data.description}
  currentId={article.id}
  showRail={showRail}
>
  <Doc doc={article}>
    <Content />
  </Doc>
  <Fragment slot="rail">
    <Toc headings={zhHeadings} headingsEn={enHeadings} />
  </Fragment>
</ReadingShell>
