---
import Base from '@/layouts/Base.astro';
import ArticleIndex from '@/components/shell/ArticleIndex.astro';
import { copy } from '@/lib/i18n';
import { ARTICLES_PER_PAGE, publishedArticles } from '@/lib/tags';

export async function getStaticPaths() {
  const articles = await publishedArticles();
  const totalPages = Math.max(1, Math.ceil(articles.length / ARTICLES_PER_PAGE));
  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    paths.push({ params: { page: String(page) } });
  }
  return paths;
}

const page = Number(Astro.params.page);
---

<Base
  title={copy['zh-CN'].articlesTitle}
  titleEn={copy.en.articlesTitle}
  description={copy['zh-CN'].articlesDesc}
  descriptionEn={copy.en.articlesDesc}
>
  <ArticleIndex page={page} />
</Base>
