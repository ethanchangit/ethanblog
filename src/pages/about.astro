---
import Base from '@/layouts/Base.astro';
import { profile, skills } from '@/data/profile';

const domains = [...new Set(skills.map((s) => s.domain))];
---

<Base title="关于" description={profile.bio}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <p class="ui-eyebrow">About</p>
      <h1 class="text-3xl font-semibold text-ink-100">
        {profile.name} <span class="text-ink-500">· {profile.chineseName}</span>
      </h1>
      <p class="mt-2 text-sm text-ink-500">{profile.role.join(' / ')}</p>
    </header>

    <div class="prose-site">
      <p>{profile.bio}</p>

      <h2>我在做什么</h2>
      <ul>
        <li><strong>iOS 开发</strong> —— 用 Swift 和 SwiftUI 构建原生应用</li>
        <li><strong>AI 集成</strong> —— 用 LLM 和语音 AI 增强生产力工具</li>
        <li><strong>个人知识管理</strong> —— 打造帮助捕捉和组织思考的工具与方法</li>
      </ul>
    </div>

    <section class="mt-12">
      <h2 class="mb-6 text-xl font-semibold text-ink-100">技术栈</h2>
      <div class="grid gap-8 sm:grid-cols-2">
        {
          domains.map((domain) => (
            <div>
              <h3 class="ui-section-label">{domain}</h3>
              <ul class="flex flex-wrap gap-x-3 gap-y-1">
                {skills
                  .filter((s) => s.domain === domain)
                  .map((s) => (
                    <li class="text-sm text-ink-300">{s.name}</li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="mb-3 text-xl font-semibold text-ink-100">联系我</h2>
      <ul class="flex flex-wrap gap-4 text-sm">
        {
          profile.socials.map((s) => (
            <li>
              <a
                href={s.url}
                class="text-ink-300 underline decoration-ink-500 underline-offset-2 transition-colors hover:text-ink-100 hover:decoration-ink-300"
                target={s.url.startsWith('http') ? '_blank' : undefined}
                rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {s.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Base>
