---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { threads } from '@/data/threads';

const stories = await getCollection('stories', ({ data }) => !data.draft);

// 状态徽章：视觉语言参照 src/lib/format.ts 的 statusLabel
const statusBadge: Record<string, { text: string; class: string }> = {
  active: { text: '活跃', class: 'bg-accent-900/60 text-accent-300' },
  dormant: { text: '蛰伏', class: 'bg-surface-800 text-ink-400' },
  closed: { text: '已收束', class: 'bg-surface-800 text-ink-500' },
};

const rows = threads.map((thread) => {
  const entries = stories.filter((s) => s.data.thread === thread.slug);
  const notes = entries.filter((s) => s.data.kind === 'notebook').length;
  const finals = entries.length - notes;
  return { thread, notes, finals };
});
---

<Base title="研究线" description="长期追问的问题。文章与笔记都挂在线下，线比时间更重要。">
  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <p class="mb-1 font-mono text-xs uppercase tracking-widest text-accent-400">Threads</p>
      <h1 class="text-3xl font-semibold text-ink-100">研究线</h1>
      <p class="mt-3 max-w-xl text-ink-400">
        长期追问的问题。文章与笔记都挂在线下，线比时间更重要。
      </p>
    </header>
    <div class="grid gap-4">
      {
        rows.map(({ thread, notes, finals }) => (
          <a
            href={`/threads/${thread.slug}`}
            class="group flex flex-col rounded-xl border border-surface-800 bg-surface-900 p-5 transition-all hover:-translate-y-0.5 hover:border-surface-700 hover:shadow-lg hover:shadow-primary-900/20"
          >
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-lg font-semibold text-ink-100 transition-colors group-hover:text-primary-300">
                {thread.title}
              </h2>
              <span
                class:list={[
                  'shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium',
                  statusBadge[thread.status].class,
                ]}
              >
                {statusBadge[thread.status].text}
              </span>
            </div>
            <p class="mt-3 text-xl font-medium leading-snug text-ink-200">{thread.question}</p>
            <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-ink-400">
              {thread.description}
            </p>
            <p class="mt-4 font-mono text-xs text-ink-500">
              {thread.started} 起 · {notes} 篇笔记 · {finals} 篇定稿
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
