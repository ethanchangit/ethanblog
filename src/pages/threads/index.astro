---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { threads } from '@/data/threads';

const stories = await getCollection('stories', ({ data }) => !data.draft);

// 状态徽章：视觉语言参照 src/lib/format.ts 的 statusLabel
const statusBadge: Record<string, { text: string; class: string }> = {
  active: { text: '活跃', class: 'ui-badge ui-badge--active' },
  dormant: { text: '蛰伏', class: 'ui-badge' },
  closed: { text: '已收束', class: 'ui-badge' },
};

const rows = threads.map((thread) => {
  const entries = stories.filter((s) => s.data.thread === thread.slug);
  const notes = entries.filter((s) => s.data.kind === 'notebook').length;
  const finals = entries.length - notes;
  return { thread, notes, finals };
});
---

<Base title="研究线" description="长期追问的问题。文章与笔记都挂在线下，线比时间更重要。">
  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <p class="ui-eyebrow">Threads</p>
      <h1 class="text-3xl font-semibold text-ink-100">研究线</h1>
      <p class="mt-3 max-w-xl text-ink-400">
        长期追问的问题。文章与笔记都挂在线下，线比时间更重要。
      </p>
    </header>
    <div class="flex flex-col gap-10">
      {
        rows.map(({ thread, notes, finals }) => (
          <a
            href={`/threads/${thread.slug}`}
            class="group block transition-colors"
          >
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-lg font-semibold text-ink-100 transition-colors group-hover:text-ink-50">
                {thread.title}
              </h2>
              <span class:list={['text-xs font-medium', statusBadge[thread.status].class]}>
                {statusBadge[thread.status].text}
              </span>
            </div>
            <p class="mt-3 text-xl font-medium leading-snug text-ink-200">{thread.question}</p>
            <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-ink-400">
              {thread.description}
            </p>
            <p class="ui-meta mt-4">
              {thread.started} 起 · {notes} 篇笔记 · {finals} 篇定稿
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
