---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { threads, type Thread } from '@/data/threads';

export async function getStaticPaths() {
  // 构建期完整性校验：frontmatter 里出现的 thread 必须都在 threads.ts 登记过
  const all = await getCollection('articles');
  const registered = new Set(threads.map((t) => t.slug));
  const unregistered = [
    ...new Set(
      all
        .map((s) => s.data.thread)
        .filter((slug): slug is string => !!slug && !registered.has(slug))
    ),
  ];
  if (unregistered.length > 0) {
    throw new Error(
      `存在未在 src/data/threads.ts 登记的研究线 slug：${unregistered.join('、')}。` +
        '请先在 threads 数组中登记这条线，再把笔记挂上去。'
    );
  }
  return threads.map((thread) => ({ params: { thread: thread.slug }, props: { thread } }));
}

interface Props {
  thread: Thread;
}
const { thread } = Astro.props;
---

<Base title={thread.title} titleEn={thread.titleEn} description={thread.question} descriptionEn={thread.questionEn}>
</Base>
