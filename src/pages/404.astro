---
import Base from '@/layouts/Base.astro';
import I18n from '@/components/shell/I18n.astro';
import { CONTACT_PATH, FOR_AGENTS_PATH, HOME_PATH, PRIVACY_PATH } from '@/lib/routes';

const lp = Astro.locals.localePath;
---

<Base title="404" titleEn="404">
  <div class="mx-auto flex max-w-3xl flex-col px-4 py-32">
    <p class="font-mono text-7xl font-medium text-surface-700">404</p>
    <h1 class="mt-4 text-xl font-semibold text-ink-100"><I18n k="notFoundTitle" /></h1>
    <p class="mt-2 text-ink-500"><I18n k="notFoundBody" /></p>
    <p class="mt-8 text-sm text-ink-400"><I18n k="notFoundTry" /></p>
    <ul class="mt-3 space-y-2 text-sm text-ink-200">
      <li>
        <a
          href={lp(HOME_PATH)}
          class="underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100 hover:decoration-ink-300"
        >
          <I18n k="backHome" />
        </a>
      </li>
      <li>
        <a
          href={lp('/articles')}
          class="underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100 hover:decoration-ink-300"
        >
          <I18n k="articlesTitle" />
        </a>
      </li>
      <li>
        <a
          href={lp(FOR_AGENTS_PATH)}
          class="underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100 hover:decoration-ink-300"
        >
          <I18n k="notFoundAgents" />
        </a>
      </li>
      <li>
        <a
          href="/llms.txt"
          class="underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100 hover:decoration-ink-300"
        >
          <I18n k="notFoundLlms" />
        </a>
      </li>
      <li>
        <a
          href="/sitemap.xml"
          class="underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100 hover:decoration-ink-300"
        >
          <I18n k="notFoundSitemap" />
        </a>
      </li>
      <li>
        <a
          href={lp(CONTACT_PATH)}
          class="underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100 hover:decoration-ink-300"
        >
          <I18n k="notFoundContact" />
        </a>
      </li>
      <li>
        <a
          href={lp(PRIVACY_PATH)}
          class="underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100 hover:decoration-ink-300"
        >
          <I18n k="notFoundPrivacy" />
        </a>
      </li>
    </ul>
  </div>
</Base>
