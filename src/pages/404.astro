---
import Base from '@/layouts/Base.astro';
---

<Base title="404">
  <div class="mx-auto flex max-w-5xl flex-col items-center px-4 py-32 text-center">
    <p class="font-mono text-7xl font-medium text-surface-700">404</p>
    <h1 class="mt-4 text-xl font-semibold text-ink-100">这个页面不存在</h1>
    <p class="mt-2 text-ink-500">它可能被移动了，或者从未存在过。</p>
    <a
      href="/"
      class="mt-8 text-sm text-ink-200 underline decoration-ink-500 underline-offset-4 transition-colors hover:text-ink-100 hover:decoration-ink-300"
    >
      回到主页
    </a>
  </div>
</Base>
