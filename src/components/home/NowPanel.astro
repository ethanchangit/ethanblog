---
import { now, nowUpdated } from '@/data/profile';
---

<div>
  <div class="mb-4 flex items-center justify-between">
    <p class="ui-eyebrow">Now</p>
    <p class="ui-meta">更新于 {nowUpdated}</p>
  </div>
  <dl class="grid gap-6 sm:grid-cols-3">
    {
      now.map((item) => (
        <div>
          <dt class="ui-meta mb-1">{item.verb}</dt>
          <dd class="text-sm leading-relaxed text-ink-300">{item.text}</dd>
        </div>
      ))
    }
  </dl>
</div>
