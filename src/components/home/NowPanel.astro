---
import I18n from '@/components/shell/I18n.astro';
import { now } from '@/data/profile';
import { nowVerbKey } from '@/lib/i18n';
---

<dl class="space-y-8">
  {
    now.map((item) => {
      const verbKey = nowVerbKey(item.verb);
      return (
        <div>
          <dt class="ui-meta mb-1">{verbKey ? <I18n k={verbKey} /> : item.verb}</dt>
          <dd class="text-base leading-relaxed text-ink-300">
            <span class="i18n-zh">{item.text}</span>

          </dd>
        </div>
      );
    })
  }
</dl>
