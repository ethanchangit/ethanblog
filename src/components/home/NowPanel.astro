---
import { now, nowUpdated } from '@/data/profile';
---

<div class="rounded-xl border border-surface-800">
  <div class="flex items-center justify-between border-b border-surface-800 px-5 py-2.5">
    <p class="font-mono text-xs uppercase tracking-widest text-accent-400">
      <span class="mr-1.5 inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-accent-400"></span>Now
    </p>
    <p class="font-mono text-xs text-ink-600">更新于 {nowUpdated}</p>
  </div>
  <dl class="grid gap-px overflow-hidden rounded-b-xl bg-surface-800 sm:grid-cols-3">
    {
      now.map((item) => (
        <div class="bg-surface-900 p-5">
          <dt class="mb-1 font-mono text-xs text-ink-500">{item.verb}</dt>
          <dd class="text-sm leading-relaxed text-ink-300">{item.text}</dd>
        </div>
      ))
    }
  </dl>
</div>
