---
import { getEntry, render } from 'astro:content';
import { profile } from '@/data/profile';

const about = await getEntry('pages', 'about');
const Content = about ? (await render(about)).Content : null;
---

<article class="px-4 py-14 sm:px-6" data-about-panel>
  <header class="mb-10">
    <h1 class="text-3xl font-semibold tracking-tight text-ink-100 sm:text-4xl">
      {profile.name} · {profile.chineseName}
    </h1>
  </header>

  {
    Content && (
      <div class="prose-site" data-about-howto>
        <Content />
      </div>
    )
  }
</article>
