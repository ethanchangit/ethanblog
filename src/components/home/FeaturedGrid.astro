---
import Card from '@/components/shell/Card.astro';
import { getCollection } from 'astro:content';
import { formatDate, statusLabel } from '@/lib/format';

const stories = (await getCollection('stories', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    stories.map((s) => (
      <Card
        href={`/stories/${s.id}`}
        title={s.data.title}
        description={s.data.description}
        meta={formatDate(s.data.date)}
        badge={s.data.kind === 'interactive' ? { text: '互动故事', accent: true } : { text: '文章' }}
        tags={s.data.tags}
      />
    ))
  }
  {
    projects.map((p) => (
      <Card
        href={`/projects/${p.id}`}
        title={p.data.name}
        description={p.data.tagline}
        meta={p.data.platforms.join(' · ') || undefined}
        badge={{ text: statusLabel[p.data.status].text, accent: p.data.status === 'active' }}
        tags={p.data.stack}
      />
    ))
  }
</div>
