---
import I18n from '@/components/shell/I18n.astro';
import { copy } from '@/lib/i18n';

interface Props {
  query?: string;
}

const { query = '' } = Astro.props;
---

<label class="mb-8 block">
  <span class="sr-only"><I18n k="searchLabel" /></span>
  <input
    class="comment-field mt-1"
    type="search"
    name="q"
    value={query}
    placeholder={copy['zh-CN'].searchPlaceholder}
    autocomplete="off"
    data-i18n-placeholder="searchPlaceholder"
    data-testid="site-search"
  />
</label>
