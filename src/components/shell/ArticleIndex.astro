---
import Card from '@/components/shell/Card.astro';
import ReadingExpand from '@/components/shell/ReadingExpand.astro';
import ReadingIndexSwitch from '@/components/shell/ReadingIndexSwitch.astro';
import { ARTICLES_PATH, HOME_PATH } from '@/lib/routes';
import { seriesParentId } from '@/lib/docs';
import { articleCardProps, groupArticlesByYear, publishedArticles } from '@/lib/tags';

interface Props {
  currentId?: string;
}

const { currentId } = Astro.props;
const lp = Astro.locals.localePath;
const all = await publishedArticles();
const groups = groupArticlesByYear(all);
const activeId = currentId ? (seriesParentId(currentId) ?? currentId) : undefined;
---

<section class="mx-auto max-w-3xl px-4 pb-14 sm:px-6" data-reading-index-body>
  <div class="reading-index-heading mb-10">
    <ReadingIndexSwitch active="articles" />
    <ReadingExpand expandHref={lp(ARTICLES_PATH)} collapseHref={lp(HOME_PATH)} />
  </div>
  {
    groups.map((group, index) => (
      <section class:list={[index > 0 && 'mt-10']}>
        <h2 class="mb-2 text-xl font-semibold tracking-tight text-ink-100 sm:text-2xl">{group.year}</h2>
        <div class="flex flex-col">
          {group.items.map((entry) => {
            const card = articleCardProps(entry);
            return (
              <Card
                href={lp(card.href)}
                title={card.title}
                titleEn={card.titleEn}
                description={card.description}
                descriptionEn={card.descriptionEn}
                meta={card.meta}
                metaEn={card.metaEn}
                tags={card.tags}
                current={entry.id === activeId}
              />
            );
          })}
        </div>
      </section>
    ))
  }
</section>
