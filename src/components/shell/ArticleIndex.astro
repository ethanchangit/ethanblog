---
import Card from '@/components/shell/Card.astro';
import I18n from '@/components/shell/I18n.astro';
import ReadingExpand from '@/components/shell/ReadingExpand.astro';
import ReadingIndexSwitch from '@/components/shell/ReadingIndexSwitch.astro';
import { articlesPageHref, ARTICLES_PATH, HOME_PATH } from '@/lib/routes';
import { seriesParentId } from '@/lib/docs';
import {
  articleCardProps,
  groupArticlesByYear,
  paginateArticles,
  publishedArticles,
} from '@/lib/tags';

interface Props {
  page: number;
  currentId?: string;
}

const { page, currentId } = Astro.props;
const lp = Astro.locals.localePath;
const all = await publishedArticles();
const paged = paginateArticles(all, page);
const groups = groupArticlesByYear(paged.items);
const activeId = currentId ? (seriesParentId(currentId) ?? currentId) : undefined;
---

<section class="mx-auto max-w-3xl px-4 pb-14 sm:px-6" data-reading-index-body>
  <div class="reading-index-heading mb-10">
    <ReadingIndexSwitch active="articles" />
    <ReadingExpand expandHref={lp(ARTICLES_PATH)} collapseHref={lp(HOME_PATH)} />
  </div>
  {
    groups.map((group, index) => (
      <section class:list={[index > 0 && 'mt-10']}>
        <h2 class="mb-2 text-xl font-semibold tracking-tight text-ink-100 sm:text-2xl">{group.year}</h2>
        <div class="flex flex-col">
          {group.items.map((entry) => {
            const card = articleCardProps(entry);
            return (
              <Card
                href={lp(card.href)}
                title={card.title}
                titleEn={card.titleEn}
                description={card.description}
                descriptionEn={card.descriptionEn}
                meta={card.meta}
                metaEn={card.metaEn}
                tags={card.tags}
                current={entry.id === activeId}
              />
            );
          })}
        </div>
      </section>
    ))
  }
  {
    paged.totalPages > 1 && (
      <nav
        class="mt-12 flex flex-col gap-2"
        aria-label="文章分页"
        data-i18n-aria="articlesPagerAria"
      >
        {paged.hasPrev && (
          <a href={lp(articlesPageHref(paged.page - 1))} class="ui-link-subtle self-start">
            {'<- '}
            <I18n k="articlesNewer" />
          </a>
        )}
        {paged.hasNext && (
          <a href={lp(articlesPageHref(paged.page + 1))} class="ui-link-subtle self-end">
            <I18n k="articlesEarlier" />
            {' ->'}
          </a>
        )}
      </nav>
    )
  }
</section>
