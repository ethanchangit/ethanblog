---
import Bi from '@/components/shell/Bi.astro';
import I18n from '@/components/shell/I18n.astro';
import { docHref, type SeriesContext } from '@/lib/docs';

interface Props {
  series: SeriesContext;
  part: 'parent' | 'pager';
}

const { series, part } = Astro.props;
const { hub, prev, next, isChapter } = series;
const lp = Astro.locals.localePath;
---

{
  part === 'parent' && isChapter && hub && (
    <p class="mt-3" data-series="parent">
      <a href={lp(docHref(hub))} class="ui-link-subtle">
        <Bi zh={hub.data.title} en={hub.data.titleEn} />
      </a>
    </p>
  )
}

{
  part === 'pager' && isChapter && (prev || next) && (
    <nav
      class="flex items-baseline justify-between gap-4"
      aria-label="系列导航"
      data-i18n-aria="seriesNavAria"
      data-series="pager"
    >
      <span>
        {prev ? (
          <a href={lp(docHref(prev))} class="ui-link-subtle" data-series-prev>
            <I18n k="seriesPrev" />
          </a>
        ) : null}
      </span>
      <span class="text-right">
        {next ? (
          <a href={lp(docHref(next))} class="ui-link-subtle" data-series-next>
            <I18n k="seriesNext" />
          </a>
        ) : null}
      </span>
    </nav>
  )
}
