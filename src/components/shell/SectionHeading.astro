---
interface Props {
  title: string;
  eyebrow?: string;
  href?: string;
  linkLabel?: string;
}
const { title, eyebrow, href, linkLabel = '查看全部 →' } = Astro.props;
---

<div class="mb-6 flex items-end justify-between gap-4">
  <div>
    {eyebrow && <p class="mb-1 font-mono text-xs uppercase tracking-widest text-accent-400">{eyebrow}</p>}
    <h2 class="text-2xl font-semibold text-ink-100">{title}</h2>
  </div>
  {
    href && (
      <a href={href} class="shrink-0 text-sm text-ink-500 transition-colors hover:text-primary-400">
        {linkLabel}
      </a>
    )
  }
</div>
