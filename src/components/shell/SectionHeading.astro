---
interface Props {
  title: string;
  eyebrow?: string;
  href?: string;
  linkLabel?: string;
}
const { title, eyebrow, href, linkLabel = '查看全部 →' } = Astro.props;
---

<div class="mb-6 flex items-end justify-between gap-4">
  <div>
    {eyebrow && <p class="ui-eyebrow">{eyebrow}</p>}
    <h2 class="text-2xl font-semibold text-ink-100">{title}</h2>
  </div>
  {
    href && (
      <a href={href} class="ui-link-subtle shrink-0">
        {linkLabel}
      </a>
    )
  }
</div>
