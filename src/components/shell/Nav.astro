---
import I18n from '@/components/shell/I18n.astro';
import { copy, type CopyKey } from '@/lib/i18n';
import { ARTICLES_PATH, PROJECTS_PATH } from '@/lib/routes';

const links: { href: string; key: CopyKey }[] = [
  { href: ARTICLES_PATH, key: 'navArticles' },
  { href: PROJECTS_PATH, key: 'navProjects' },
  { href: '/about', key: 'navAbout' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 bg-surface-950">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-2 px-4 sm:gap-4 sm:px-6">
    <a
      href="/"
      aria-label={copy['zh-CN'].navHome}
      data-i18n-aria="navHome"
      class="shrink-0 px-1.5 py-1.5 text-xs font-semibold text-ink-100 transition-colors hover:text-ink-100 sm:px-2 sm:text-sm"
    >
      EthanChang
    </a>
    <ul class="flex min-w-0 items-center gap-0.5 sm:gap-1 md:gap-3">
      {
        links.map((link) => (
          <li class="shrink-0">
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'px-1.5 py-1.5 text-xs transition-colors sm:px-2 sm:text-sm',
                isActive(link.href)
                  ? 'text-ink-100'
                  : 'text-ink-400 hover:text-ink-100',
              ]}
            >
              <I18n k={link.key} />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
