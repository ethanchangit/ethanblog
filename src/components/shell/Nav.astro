---
import { site } from '@/data/profile';

const links = [
  { href: '/stories', label: '故事' },
  { href: '/projects', label: '作品' },
  { href: '/about', label: '关于' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header
  class="sticky top-0 z-50 border-b border-surface-800/80 bg-surface-950/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
    <a
      href="/"
      class="font-mono text-sm font-medium text-ink-100 transition-colors hover:text-accent-300"
      aria-label={site.title}
    >
      {site.wordmark}<span class="text-accent-400">_</span>
    </a>
    <ul class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm transition-colors',
                isActive(link.href)
                  ? 'bg-surface-800 text-ink-100'
                  : 'text-ink-400 hover:bg-surface-900 hover:text-ink-100',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
