---
import { getCollection } from 'astro:content';
import I18n from '@/components/shell/I18n.astro';
import { pageOrder } from '@/data/page-order';
import { copy, DEFAULT_LANG, type CopyKey } from '@/lib/i18n';
import { pagePath } from '@/lib/locale';
import { CONTACT_PATH, HOME_PATH, NOW_PATH, PRIVACY_PATH, SEARCH_PATH, TAGS_PATH } from '@/lib/routes';
import { languageSwitchHref } from '@/lib/hosts';

const lp = Astro.locals.localePath;
const published = await getCollection('pages', ({ id, data }) => id !== 'blogs' && !data.draft);
const rank = new Map<string, number>(pageOrder.map((id, index) => [id, index]));
const hrefFor = (id: string) => (id === 'about' ? HOME_PATH : id === 'now' ? NOW_PATH : id === 'contact' ? CONTACT_PATH : id === 'privacy' ? PRIVACY_PATH : `/pages/${id}`);
const labelFor = (id: string, title: string): { key?: CopyKey; text?: string } => {
  if (id === 'about') return { text: 'EthanChang' };
  if (id === 'now') return { key: 'navNow' };
  if (id === 'contact') return { key: 'navContact' };
  if (id === 'privacy') return { key: 'navPrivacy' };
  return { text: title };
};
/** 顺序来自 src/data/page-order.ts。第一页靠左，其余跟在后面。标签和搜索不是站点页。 */
const stations = published
  .filter((page) => rank.has(page.id))
  .sort((a, b) => (rank.get(a.id) ?? 0) - (rank.get(b.id) ?? 0))
  .slice(0, 4)
  .map((page) => ({ id: page.id, href: hrefFor(page.id), ...labelFor(page.id, page.data.title) }));
const [lead, ...rest] = stations;
const tools: { href: string; key: CopyKey }[] = [{ href: TAGS_PATH, key: 'navTags' }];

const path = pagePath(Astro.url.pathname);
// The other site: ethanchang.io (English) <-> cn.ethanchang.io (Chinese). Articles also switch in place.
const english = Astro.locals.lang === 'en';
const otherSite = english
  ? { href: languageSwitchHref('zh', '/'), text: '中', label: '中文博客', hreflang: 'zh-CN' }
  : { href: languageSwitchHref('en', '/'), text: 'EN', label: 'English blog', hreflang: 'en' };
const isActive = (href: string) => (href === HOME_PATH ? path === HOME_PATH : path === href || path.startsWith(href + '/'));
---

{/*
  移动端：整行渐进模糊 + 半透明渐隐；桌面端文档流随页滚走。
*/}
<header
  class="site-nav pointer-events-none fixed inset-x-0 top-0 z-50 md:pointer-events-auto md:relative md:inset-auto md:z-auto"
>
  <div class="site-nav-veil" aria-hidden="true">
    <div class="site-nav-veil-blur site-nav-veil-blur--1"></div>
    <div class="site-nav-veil-blur site-nav-veil-blur--2"></div>
    <div class="site-nav-veil-blur site-nav-veil-blur--3"></div>
    <div class="site-nav-veil-blur site-nav-veil-blur--4"></div>
    <div class="site-nav-veil-tint"></div>
  </div>
  <nav class="site-nav-bar chrome-fade-bottom relative mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-1 gap-y-0 px-4 sm:gap-x-4 sm:px-6 md:h-14 md:flex-nowrap">
    {
      lead && (
        <a
          href={lp(lead.href)}
          data-page-station={lead.id}
          aria-label={lead.id === 'about' ? copy[DEFAULT_LANG].navHome : undefined}
          data-i18n-aria={lead.id === 'about' ? 'navHome' : undefined}
          aria-current={isActive(lead.href) ? 'page' : undefined}
          class:list={[
            lead.id === 'about'
              ? 'pointer-events-auto inline-flex min-h-11 shrink-0 items-center px-1.5 text-xs font-semibold text-ink-100 transition-colors hover:text-ink-100 sm:px-2 sm:text-sm md:min-h-0 md:py-1.5'
              : 'pointer-events-auto inline-flex min-h-11 shrink-0 items-center px-2 text-xs transition-colors sm:text-sm md:min-h-0 md:py-1.5',
            lead.id === 'about' ? '' : isActive(lead.href) ? 'text-ink-100' : 'text-ink-400 hover:text-ink-100',
          ]}
        >
          {lead.key ? <I18n k={lead.key} /> : lead.text}
        </a>
      )
    }
    {
      rest.length > 0 && (
        <ul
          class="site-nav-stations pointer-events-auto order-last flex w-full items-center justify-between md:order-none md:ml-auto md:w-auto md:justify-end md:gap-3"
          aria-label={copy[DEFAULT_LANG].navPages}
        >
          {
            rest.map((link) => (
              <li class="shrink-0">
                <a
                  href={lp(link.href)}
                  data-page-station={link.id}
                  aria-label={link.id === 'about' ? copy[DEFAULT_LANG].navHome : undefined}
                  data-i18n-aria={link.id === 'about' ? 'navHome' : undefined}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    link.id === 'about'
                      ? 'inline-flex min-h-11 items-center px-1.5 text-xs font-semibold text-ink-100 transition-colors sm:px-2 sm:text-sm md:min-h-0 md:py-1.5'
                      : 'inline-flex min-h-11 min-w-11 items-center justify-center px-2 text-xs transition-colors sm:text-sm md:min-h-0 md:min-w-0 md:py-1.5',
                    link.id === 'about' || isActive(link.href) ? 'text-ink-100' : 'text-ink-400 hover:text-ink-100',
                  ]}
                >
                  {link.key ? <I18n k={link.key} /> : link.text}
                </a>
              </li>
            ))
          }
        </ul>
      )
    }
    <ul class="pointer-events-auto flex min-w-0 items-center gap-0.5 sm:gap-1 md:gap-3">
      {
        tools.map((link) => (
          <li class="shrink-0">
            <a
              href={lp(link.href)}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center px-2 text-xs transition-colors sm:px-2 sm:text-sm md:min-h-0 md:py-1.5',
                isActive(link.href)
                  ? 'text-ink-100'
                  : 'text-ink-400 hover:text-ink-100',
              ]}
            >
              <I18n k={link.key} />
            </a>
          </li>
        ))
      }
      <li class="shrink-0">
        <a
          href={otherSite.href}
          hreflang={otherSite.hreflang}
          aria-label={otherSite.label}
          data-site-switch
          class="inline-flex min-h-11 min-w-11 items-center justify-center px-1.5 text-xs text-ink-400 transition-colors hover:text-ink-100 sm:px-2 sm:text-sm md:min-h-0 md:min-w-0 md:py-1.5"
        >
          {otherSite.text}
        </a>
      </li>
      <li class="shrink-0">
        <a
          href={lp(SEARCH_PATH)}
          aria-current={isActive(SEARCH_PATH) ? 'page' : undefined}
          aria-label={copy[DEFAULT_LANG].navSearch}
          data-i18n-aria="navSearch"
          class:list={[
            'inline-flex min-h-11 min-w-11 items-center justify-center px-1.5 transition-colors sm:px-2 md:min-h-0 md:min-w-0 md:py-1.5',
            isActive(SEARCH_PATH) ? 'text-ink-100' : 'text-ink-400 hover:text-ink-100',
          ]}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-3.5-3.5"></path>
          </svg>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { initReadingIndexSwap } from '@/lib/reading-index-swap';
  initReadingIndexSwap();
</script>
