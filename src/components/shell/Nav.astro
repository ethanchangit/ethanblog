---
import I18n from '@/components/shell/I18n.astro';
import LangToggle from '@/components/shell/LangToggle.svelte';
import type { CopyKey } from '@/lib/i18n';
import { ARTICLES_PATH, PROJECTS_PATH } from '@/lib/routes';

const links: { href: string; key: CopyKey }[] = [
  { href: ARTICLES_PATH, key: 'navArticles' },
  { href: PROJECTS_PATH, key: 'navProjects' },
  { href: '/about', key: 'navAbout' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

{/*
  移动端：整行渐进模糊 + 半透明渐隐；桌面端文档流随页滚走。
*/}
<header
  class="site-nav pointer-events-none fixed inset-x-0 top-0 z-50 md:pointer-events-auto md:relative md:inset-auto md:z-auto"
>
  <div class="site-nav-veil" aria-hidden="true">
    <div class="site-nav-veil-blur site-nav-veil-blur--1"></div>
    <div class="site-nav-veil-blur site-nav-veil-blur--2"></div>
    <div class="site-nav-veil-blur site-nav-veil-blur--3"></div>
    <div class="site-nav-veil-blur site-nav-veil-blur--4"></div>
    <div class="site-nav-veil-tint"></div>
  </div>
  <nav class="relative mx-auto flex h-14 max-w-5xl items-center justify-end px-4 sm:px-6">
    <ul class="pointer-events-auto flex min-w-0 items-center gap-0.5 sm:gap-1 md:gap-3">
      {
        links.map((link) => (
          <li class="shrink-0">
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'px-1.5 py-1.5 text-xs transition-colors sm:px-2 sm:text-sm',
                isActive(link.href)
                  ? 'text-ink-100'
                  : 'text-ink-400 hover:text-ink-100',
              ]}
            >
              <I18n k={link.key} />
            </a>
          </li>
        ))
      }
      <li class="shrink-0">
        <LangToggle client:load />
      </li>
    </ul>
  </nav>
</header>
