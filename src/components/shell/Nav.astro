---
import { site } from '@/data/profile';
import AuthMenu from '@/components/shell/AuthMenu.svelte';
import ThemeToggle from '@/components/shell/ThemeToggle.svelte';

const links = [
  { href: '/stories', label: '故事' },
  { href: '/threads', label: '研究线' },
  { href: '/projects', label: '作品' },
  { href: '/about', label: '关于' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header
  class="sticky top-0 z-50 border-b border-surface-800 bg-surface-950"
>
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-2 px-4 sm:gap-4 sm:px-6">
    <a
      href="/"
      class="shrink-0 font-mono text-sm font-medium text-ink-100 transition-colors hover:text-accent-300"
      aria-label={site.title}
    >
      {site.wordmark}<span class="text-accent-400">_</span>
    </a>
    <ul class="flex min-w-0 items-center gap-0.5 sm:gap-1 md:gap-2">
      {
        links.map((link) => (
          <li class="shrink-0">
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-1.5 py-1.5 text-xs transition-colors sm:px-3 sm:text-sm',
                isActive(link.href)
                  ? 'bg-surface-800 text-ink-100'
                  : 'text-ink-400 hover:bg-surface-900 hover:text-ink-100',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <ThemeToggle client:load />
      </li>
      <li>
        <AuthMenu client:load />
      </li>
    </ul>
  </nav>
</header>
