---
import ReadingShell from '@/components/shell/ReadingShell.astro';
import Doc from '@/layouts/Doc.astro';
import Toc from '@/components/shell/Toc.astro';
import { docHref, languageVersions, type DocEntry } from '@/lib/docs';
import { siteUrl } from '@/lib/hosts';
import { hasToc } from '@/lib/toc';
import { render } from 'astro:content';

interface Props {
  article: DocEntry;
}

const { article } = Astro.props;
const kind = article.data.slot === 'project' ? 'project' : 'article';
const readingId = kind === 'project' ? article.id.replace(/\/[a-z]{2,3}$/, '') : article.id;
const rendered = await render(article);
const split = rendered.remarkPluginFrontmatter.i18nHeadingSplit as number | undefined;
const zhHeadings =
  typeof split === 'number' ? rendered.headings.slice(0, split) : rendered.headings;
const showRail = hasToc(zhHeadings);
const Content = rendered.Content;
const alternates = (await languageVersions(article)).map((version) => ({
  hreflang: version.lang === 'zh' ? 'zh-CN' : 'en',
  href: siteUrl(version.lang, version.href),
}));
---

<ReadingShell
  kind={kind}
  title={article.data.title}
  description={article.data.description}
  currentId={readingId}
  docHref={docHref(article)}
  alternates={alternates}
  showRail={showRail}
>
  <Doc doc={article}>
    <Content />
  </Doc>
  <Fragment slot="rail">
    <Toc headings={zhHeadings} title={article.data.title} />
  </Fragment>
</ReadingShell>
