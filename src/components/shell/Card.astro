---
interface Props {
  href: string;
  title: string;
  description?: string;
  meta?: string;
  badge?: { text: string; accent?: boolean };
  tags?: string[];
}
const { href, title, description, meta, badge, tags = [] } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-xl border border-surface-800 bg-surface-900 p-5 transition-all hover:-translate-y-0.5 hover:border-surface-700 hover:shadow-lg hover:shadow-primary-900/20"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold text-ink-100 transition-colors group-hover:text-primary-300">
      {title}
    </h3>
    {
      badge && (
        <span
          class:list={[
            'shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium',
            badge.accent
              ? 'bg-accent-900/60 text-accent-300 shadow-[0_0_12px_rgba(34,211,238,0.25)]'
              : 'bg-surface-800 text-ink-400',
          ]}
        >
          {badge.text}
        </span>
      )
    }
  </div>
  {description && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-400">{description}</p>}
  <div class="mt-auto flex items-center justify-between gap-3 pt-4">
    {meta && <p class="font-mono text-xs text-ink-500">{meta}</p>}
    {
      tags.length > 0 && (
        <ul class="flex flex-wrap justify-end gap-1.5">
          {tags.slice(0, 3).map((t) => (
            <li class="rounded bg-surface-800 px-1.5 py-0.5 font-mono text-[11px] text-ink-500">{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</a>
