---
import Bi from '@/components/shell/Bi.astro';

interface Props {
  href: string;
  title: string;
  description?: string;
  meta?: string;
  badge?: { text: string; textEn?: string; accent?: boolean };
  tags?: string[];
  current?: boolean;
}
const { href, title, description, meta, badge, tags = [], current = false } = Astro.props;
---

<a
  href={href}
  aria-current={current ? 'page' : undefined}
  class="group flex h-full flex-col py-4 transition-colors"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold text-ink-100 underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-ink-500 group-aria-[current=page]:decoration-ink-500">
      <Bi zh={title} />
    </h3>
    {
      badge && (
        <span class:list={['ui-badge', badge.accent && 'ui-badge--active']}>
          <Bi zh={badge.text} />
        </span>
      )
    }
  </div>
  {description && (
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-400 transition-colors group-hover:text-ink-300">
      <Bi zh={description} />
    </p>
  )}
  <div class="mt-auto flex items-center justify-between gap-3 pt-3">
    {meta && (
      <p class="ui-meta transition-colors group-hover:text-ink-300">
        <Bi zh={meta} />
      </p>
    )}
    {
      tags.length > 0 && (
        <ul class="ui-tag-list">
          {tags.slice(0, 3).map((t) => (
            <li class="ui-tag">{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</a>
