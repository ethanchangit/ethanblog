---
interface Props {
  href: string;
  title: string;
  description?: string;
  meta?: string;
  badge?: { text: string; accent?: boolean };
  tags?: string[];
}
const { href, title, description, meta, badge, tags = [] } = Astro.props;
---

<a href={href} class="group flex h-full flex-col py-4 transition-colors">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold text-ink-100 transition-colors group-hover:text-ink-50">
      {title}
    </h3>
    {
      badge && (
        <span class:list={['ui-badge', badge.accent && 'ui-badge--active']}>
          {badge.text}
        </span>
      )
    }
  </div>
  {description && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-400">{description}</p>}
  <div class="mt-auto flex items-center justify-between gap-3 pt-3">
    {meta && <p class="ui-meta">{meta}</p>}
    {
      tags.length > 0 && (
        <ul class="flex flex-wrap justify-end gap-2">
          {tags.slice(0, 3).map((t) => (
            <li class="ui-tag">{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</a>
