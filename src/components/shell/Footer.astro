---
import LangToggle from '@/components/shell/LangToggle.svelte';
import ThemeToggle from '@/components/shell/ThemeToggle.svelte';
import { profile } from '@/data/profile';

const links = [
  ...profile.socials,
  { label: 'RSS', url: '/rss.xml', icon: 'rss' as const },
];

const iconPaths: Record<(typeof links)[number]['icon'], string[]> = {
  github: [
    'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4',
    'M9 18c-4.51 2-5-2-7-2',
  ],
  twitter: ['M18 6 6 18', 'm6 6 12 12'],
  mail: ['M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z', 'm22 6-10 7L2 6'],
  rss: ['M4 11a9 9 0 0 1 9 9', 'M4 4a16 16 0 0 1 16 16'],
};
---

<footer class="pointer-events-none fixed inset-x-0 bottom-0 z-50">
  <div class="flex h-10 items-center justify-between px-4 text-sm text-ink-500 sm:px-6">
    <div class="footer-toggles pointer-events-auto flex shrink-0 items-center gap-4 bg-surface-950">
      <LangToggle client:visible />
      <ThemeToggle client:visible />
    </div>
    <ul class="pointer-events-auto flex items-center gap-3 bg-surface-950 sm:gap-4">
      {
        links.map((s) => (
          <li>
            <a
              href={s.url}
              class="inline-flex h-4 w-4 items-center justify-center transition-colors hover:text-ink-100"
              aria-label={s.label}
              title={s.label}
              target={s.url.startsWith('http') ? '_blank' : undefined}
              rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <svg
                class="block"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {iconPaths[s.icon].map((d) => (
                  <path d={d} />
                ))}
                {s.icon === 'rss' && <circle cx="5" cy="19" r="1" />}
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer-toggles :global(astro-island) {
    display: inline-flex;
    align-items: center;
  }
</style>
