---
import Base from '@/layouts/Base.astro';
import ArticleIndex from '@/components/shell/ArticleIndex.astro';
import ProjectsIndex from '@/components/shell/ProjectsIndex.astro';
import I18n from '@/components/shell/I18n.astro';
import { articleHref, ARTICLES_PATH, HOME_PATH, projectHref, PROJECTS_PATH } from '@/lib/routes';
import type { CopyKey } from '@/lib/i18n';

interface Props {
  kind: 'article' | 'project' | 'home';
  title?: string;
  titleEn?: string;
  description: string;
  descriptionEn?: string;
  currentId?: string;
  showRail?: boolean;
}

const {
  kind,
  title,
  titleEn,
  description,
  descriptionEn,
  currentId,
  showRail = false,
} = Astro.props;
const persistKey = kind === 'project' ? 'reading-index-projects' : 'reading-index-articles';
const indexHref = kind === 'project' ? PROJECTS_PATH : ARTICLES_PATH;
const docSrc =
  kind === 'home' ? HOME_PATH : kind === 'article' ? articleHref(currentId ?? '') : projectHref(currentId ?? '');
const backKey: CopyKey = kind === 'project' ? 'backToProjects' : 'backToArticles';
---

<Base split title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn}>
  <div class="reading-shell" data-reading-shell={kind}>
    <aside
      class="reading-index"
      data-reading-index
      data-reading-index-src={indexHref}
      transition:persist={persistKey}
    >
      {
        kind === 'project' ? (
          <ProjectsIndex currentId={currentId} />
        ) : (
          <ArticleIndex page={1} currentId={currentId} />
        )
      }
    </aside>

    <div class="reading-doc" data-reading-pane data-reading-doc data-reading-doc-src={docSrc}>
      {
        kind !== 'home' && (
          <p class="reading-back">
            <a href={indexHref} class="ui-link-subtle">
              <I18n k={backKey} />
            </a>
          </p>
        )
      }
      <slot />
    </div>

    {
      showRail && (
        <aside class="reading-rail" data-reading-rail>
          <slot name="rail" />
        </aside>
      )
    }
  </div>
</Base>

<script>
  import { initReadingIndexSwap } from '@/lib/reading-index-swap';
  initReadingIndexSwap();
</script>
