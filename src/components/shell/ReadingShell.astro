---
import Base from '@/layouts/Base.astro';
import ArticleIndex from '@/components/shell/ArticleIndex.astro';
import ProjectsIndex from '@/components/shell/ProjectsIndex.astro';
import I18n from '@/components/shell/I18n.astro';
import {
  articleHref,
  articlesPageHref,
  ARTICLES_PATH,
  HOME_PATH,
  projectHref,
  PROJECTS_PATH,
} from '@/lib/routes';
import type { CopyKey } from '@/lib/i18n';

interface Props {
  kind: 'article' | 'project' | 'home' | 'index';
  indexList?: 'articles' | 'projects';
  indexPage?: number;
  title?: string;
  titleEn?: string;
  description: string;
  descriptionEn?: string;
  currentId?: string;
  showRail?: boolean;
}

const {
  kind,
  indexList,
  indexPage = 1,
  title,
  titleEn,
  description,
  descriptionEn,
  currentId,
  showRail = false,
} = Astro.props;
const lp = Astro.locals.localePath;
const listKind: 'articles' | 'projects' =
  indexList ?? (kind === 'project' ? 'projects' : 'articles');
const persistKey = listKind === 'projects' ? 'reading-index-projects' : 'reading-index-articles';
const indexHref = lp(
  listKind === 'projects'
    ? PROJECTS_PATH
    : kind === 'index'
      ? articlesPageHref(indexPage)
      : ARTICLES_PATH,
);
const docSrc =
  kind === 'index'
    ? ''
    : lp(kind === 'home' ? HOME_PATH : kind === 'article' ? articleHref(currentId ?? '') : projectHref(currentId ?? ''));
const backKey: CopyKey = kind === 'project' || listKind === 'projects' ? 'backToProjects' : 'backToArticles';
const showProjects = listKind === 'projects';
---

<Base split title={title} titleEn={titleEn} description={description} descriptionEn={descriptionEn}>
  <div class="reading-shell" data-reading-shell={kind}>
    <aside
      class="reading-index"
      data-reading-index
      data-reading-index-src={indexHref}
      transition:persist={persistKey}
    >
      {
        showProjects ? (
          <ProjectsIndex currentId={currentId} />
        ) : (
          <ArticleIndex page={kind === 'index' ? indexPage : 1} currentId={currentId} />
        )
      }
    </aside>

    {
      kind !== 'home' && kind !== 'index' && (
        <p class="reading-back">
          <a href={indexHref} class="ui-link-subtle">
            <I18n k={backKey} />
          </a>
        </p>
      )
    }

    {
      showRail && (
        <aside class="reading-rail" data-reading-rail>
          <slot name="rail" />
        </aside>
      )
    }

    <div
      class="reading-doc"
      data-reading-pane
      data-reading-doc
      data-reading-doc-src={docSrc}
      inert={kind === 'index'}
      aria-hidden={kind === 'index' ? 'true' : undefined}
    >
      <slot />
    </div>
  </div>
</Base>

<script>
  import { initReadingIndexSwap } from '@/lib/reading-index-swap';
  import { initReadingSeriesPane } from '@/lib/reading-series-pane';
  initReadingIndexSwap();
  initReadingSeriesPane();
</script>
