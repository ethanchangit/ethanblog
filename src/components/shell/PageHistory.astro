---
/**
 * PageHistory — 「这一页如何长成」：把文章文件的 git 提交史渲染成文末折叠时间线。
 * 版本历史即媒介（Upwelling/Patchwork）：修订说明写给读者看，不是行政开销。
 * 页面接口（MEDIUM §6），非媒介组件——由 Article.astro 在 history: true 时自动渲染。
 */
import DateText from '@/components/shell/DateText.astro';
import I18n from '@/components/shell/I18n.astro';
import { copy } from '@/lib/i18n';
import type { CommitInfo } from '@/lib/history';

interface Props {
  commits: CommitInfo[];
}

const { commits } = Astro.props;
const n = String(commits.length);
---

<details class="page-history">
  <summary>
    <span class="i18n-zh">{copy['zh-CN'].pageHistory.replace('{n}', n)}</span>
    <span class="i18n-en" aria-hidden="true">{copy.en.pageHistory.replace('{n}', n)}</span>
  </summary>
  <ol>
    {
      commits.map((c) => (
        <li>
          <time datetime={c.date}>
            <DateText date={new Date(c.date)} />
          </time>
          <span class:list={['ui-badge', c.kind === 'publish' && 'ui-badge--active']}>
            <I18n
              k={c.kind === 'publish' ? 'historyPublish' : c.kind === 'revise' ? 'historyRevise' : 'historyUpdate'}
            />
          </span>
          <span>{c.subject}</span>
        </li>
      ))
    }
  </ol>
</details>
