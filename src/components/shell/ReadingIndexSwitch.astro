---
import I18n from '@/components/shell/I18n.astro';
import { copy, DEFAULT_LANG, type CopyKey } from '@/lib/i18n';
import { ARTICLES_PATH, PROJECTS_PATH } from '@/lib/routes';

interface Props {
  /** `/blogs` 仍可用此组件当页标题；切换项只有文章 / 项目。 */
  active: 'articles' | 'projects' | 'blogs';
}

const { active } = Astro.props;

const items: { id: 'articles' | 'projects'; href: string; key: CopyKey }[] = [
  { id: 'articles', href: Astro.locals.localePath(ARTICLES_PATH), key: 'navArticles' },
  { id: 'projects', href: Astro.locals.localePath(PROJECTS_PATH), key: 'navProjects' },
];
const currentKey: CopyKey =
  active === 'blogs' ? 'navBlogs' : items.find((item) => item.id === active)!.key;
---

<nav
  class="reading-index-switch"
  data-reading-index-switch
  aria-label={copy[DEFAULT_LANG].indexSwitchAria}
  data-i18n-aria="indexSwitchAria"
>
  <h1 class="reading-index-switch-title" aria-current="page">
    <I18n k={currentKey} />
  </h1>
  {
    items
      .filter((item) => item.id !== active)
      .map((item) => (
        <a href={item.href} class="reading-index-switch-alt">
          <I18n k={item.key} />
        </a>
      ))
  }
</nav>
