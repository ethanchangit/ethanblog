---
import Timeline from '@/components/media/Timeline.svelte';
import I18n from '@/components/shell/I18n.astro';
import Bi from '@/components/shell/Bi.astro';
import ReadingExpand from '@/components/shell/ReadingExpand.astro';
import ReadingIndexSwitch from '@/components/shell/ReadingIndexSwitch.astro';
import { lineageEdges, lineageIcons } from '@/data/projects-lineage';
import { docsBySlot } from '@/lib/docs';
import { HOME_PATH, PROJECTS_PATH, projectHref } from '@/lib/routes';

interface Props {
  currentId?: string;
}

const { currentId } = Astro.props;
const lp = Astro.locals.localePath;
const projects = (await docsBySlot('project')).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const bySlug = Object.fromEntries(projects.map((p) => [p.id, p]));

const timelineItems = projects.map((project) => ({
  title: project.data.title,
  titleEn: project.data.titleEn,
  body: project.data.description,
  bodyEn: project.data.descriptionEn,
  href: lp(projectHref(project.id)),
  icon: lineageIcons[project.id],
}));
---

<article class="mx-auto max-w-3xl px-4 pb-14 sm:px-6" data-reading-index-body>
  <div class="reading-index-heading">
    <ReadingIndexSwitch active="projects" />
    <ReadingExpand expandHref={lp(PROJECTS_PATH)} collapseHref={lp(HOME_PATH)} />
  </div>
  <header class="mb-10">
    <p class="mt-4 text-lg leading-relaxed text-ink-400">
      <I18n k="projectsLead" />
    </p>
  </header>

  <div class="prose-site">
    <h2 id="lineage"><I18n k="projectsLineageH2" /></h2>

    <p>
      <I18n k="projectsLineageP" />
    </p>

    <Timeline
      client:visible
      items={timelineItems}
      currentHref={currentId ? lp(projectHref(currentId)) : undefined}
      caption="按各项目已有的顺序排列。有些项目并行酝酿，但能力继承的方向是清晰的。"
      captionEn="Listed in each project's existing order. Some were brewing in parallel; the direction of inheritance is still clear."
    />

    <p><I18n k="projectsEdgesIntro" /></p>

    <ul>
      {
        lineageEdges.map((edge) => (
          <li>
            <a href={lp(projectHref(edge.from))}>
              {bySlug[edge.from]?.data.title ?? edge.from}
            </a>
            {' → '}
            <a href={lp(projectHref(edge.to))}>{bySlug[edge.to]?.data.title ?? edge.to}</a>
            {'：'}
            <Bi zh={edge.carries} en={edge.carriesEn} />
          </li>
        ))
      }
    </ul>
  </div>
</article>
