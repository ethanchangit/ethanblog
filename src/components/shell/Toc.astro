---
/**
 * 目录 —— 第一行是文章标题，点它回到页顶；其余只收 depth 2-3。没有小标题时不渲染。
 * 分栏阅读时浮在阅读区右侧（.reading-rail）；窄屏随 rail 一起隐藏。
 * 无 JS 时标题行仍是指向文首的锚点，当前条靠 :target 标明；有 JS 时按阅读栏滚动位置写 aria-current。
 */
import type { TocHeading } from '@/lib/toc';
import { DOC_TITLE_ID, tocEntries } from '@/lib/toc';
import { copy } from '@/lib/i18n';

interface Props {
  headings: TocHeading[];
  title: string;
}

const { headings, title } = Astro.props as Props;
const items = tocEntries(headings);

function attr(value: string): string {
  return value.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
}

const activeCss = [DOC_TITLE_ID, ...items.map((h) => h.slug)]
  .map((slug) => {
    const id = attr(slug);
    return `html:not([data-toc-ready]) body:has([id="${id}"]:target) nav.toc a[href="#${id}"]`;
  })
  .join(',\n');
---

{
  items.length > 0 && (
    <nav class="toc" aria-label={copy.en.tocAria} data-i18n-aria="tocAria">
      {activeCss && (
        <Fragment
          set:html={`<style>${activeCss}{color:var(--color-ink-200);text-decoration-color:var(--color-ink-500)}</style>`}
        />
      )}
      <ul>
        <li>
          <a href={'#' + DOC_TITLE_ID} data-toc-title title={title}>
            <span class="toc-label">{title}</span>
          </a>
        </li>
        {items.map((h) => (
          <li><a href={'#' + h.slug} data-depth={h.depth} title={h.text}><span class="toc-label">{h.text}</span></a></li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const TOC_SEL = 'nav.toc a[href^="#"]';
  const WINDOW_MARKER = 88;
  const PANE_MARKER = 32;

  let headings: HTMLElement[] = [];
  let ticking = false;

  function pane(): HTMLElement | null {
    const el = document.querySelector<HTMLElement>('[data-reading-pane]');
    if (!el) return null;
    const y = getComputedStyle(el).overflowY;
    if (y === 'visible' || y === 'clip') return null;
    return el;
  }

  function tocLinks(): HTMLAnchorElement[] {
    return [...document.querySelectorAll<HTMLAnchorElement>(TOC_SEL)];
  }

  function hashId(a: HTMLAnchorElement): string {
    try {
      return decodeURIComponent(a.hash.slice(1));
    } catch {
      return a.hash.slice(1);
    }
  }

  function setCurrent(id: string | null) {
    for (const a of tocLinks()) {
      if (id != null && hashId(a) === id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
  }

  function pickFromLayout() {
    const visible = headings.filter((h) => h.getClientRects().length > 0);
    if (!visible.length) return;
    const root = pane();
    const marker = root ? PANE_MARKER : WINDOW_MARKER;
    const origin = root ? root.getBoundingClientRect().top : 0;
    let current = visible[0].id;
    for (const h of visible) {
      if (h.getBoundingClientRect().top - origin <= marker) current = h.id;
      else break;
    }
    setCurrent(current);
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      pickFromLayout();
    });
  }

  function scrollToPageTop() {
    const root = pane();
    if (root) root.scrollTo({ top: 0, left: 0 });
    window.scrollTo({ top: 0, left: 0 });
  }

  function onClick(event: MouseEvent) {
    const a = (event.target as HTMLElement | null)?.closest?.<HTMLAnchorElement>(TOC_SEL);
    if (!a) return;
    const id = hashId(a);
    const root = pane();
    if (a.hasAttribute('data-toc-title')) {
      event.preventDefault();
      scrollToPageTop();
      history.replaceState(null, '', `#${id}`);
      setCurrent(id);
      return;
    }
    const el = document.getElementById(id);
    if (!el) return;
    if (root) {
      event.preventDefault();
      el.scrollIntoView({ block: 'start' });
      history.replaceState(null, '', `#${id}`);
      setCurrent(id);
    }
  }

  function teardown() {
    window.removeEventListener('scroll', onScroll);
    pane()?.removeEventListener('scroll', onScroll);
    document.removeEventListener('click', onClick);
    document.documentElement.removeAttribute('data-toc-ready');
    headings = [];
    setCurrent(null);
  }

  function setup() {
    teardown();
    const ids = [...new Set(tocLinks().map(hashId))];
    headings = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el)
      .sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));
    if (!headings.length) return;

    document.documentElement.setAttribute('data-toc-ready', '');
    pickFromLayout();
    const root = pane();
    if (root) root.addEventListener('scroll', onScroll, { passive: true });
    else window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('click', onClick);
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('hashchange', pickFromLayout);
  new MutationObserver(() => pickFromLayout()).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-lang'],
  });
</script>
