---
import { copy, DEFAULT_LANG } from '@/lib/i18n';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  class="reading-expand"
  data-reading-close
  aria-label={copy[DEFAULT_LANG].closeReading}
  data-i18n-aria="closeReading"
>
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M15 3h6v6"></path>
    <path d="M21 3l-7 7"></path>
    <path d="M3 21l7-7"></path>
    <path d="M9 21H3v-6"></path>
  </svg>
</a>
