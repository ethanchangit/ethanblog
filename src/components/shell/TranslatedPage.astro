---
import { type CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import DateText from '@/components/shell/DateText.astro';
import I18n from '@/components/shell/I18n.astro';
import { sitePageHref } from '@/lib/docs';
import { languageSwitchHref, siteUrl } from '@/lib/hosts';
import { t } from '@/lib/i18n';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { Content } = await render(page);
const href = sitePageHref(page.id);
const uiLang = Astro.locals.lang === 'en' ? 'en' : 'zh-CN';
const typeName = page.data.language ? `Translation · ${page.data.language}` : 'Translation';
const alternates = [
  { hreflang: 'zh-CN', href: siteUrl('zh', href) },
  { hreflang: 'en', href: siteUrl('en', href) },
];
---

<Base title={page.data.title} description={page.data.description} alternates={alternates}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <a href={languageSwitchHref('zh', href)} hreflang="zh-CN" lang="zh-CN" class="ui-meta ui-link" data-language-switch="zh">中文</a>
      </div>
      <h1 class="text-3xl font-semibold leading-snug text-ink-100 sm:text-4xl">{page.data.title}</h1>
      <section class="article-meta mt-8" aria-label={t(uiLang, 'metaProperties')}>
        <p class="article-meta-label"><I18n k="metaProperties" /></p>
        <dl class="article-meta-grid">
          <dt><I18n k="metaType" /></dt>
          <dd>{typeName}</dd>
          <dt><I18n k="metaAddress" /></dt>
          <dd><code>{href}</code></dd>
          {
            page.data.date && (
              <>
                <dt><I18n k="metaDate" /></dt>
                <dd>
                  <time datetime={page.data.date.toISOString()}>
                    <DateText date={page.data.date} />
                  </time>
                </dd>
              </>
            )
          }
        </dl>
      </section>
    </header>
    <div class="prose-site">
      <Content />
    </div>
  </article>
</Base>
