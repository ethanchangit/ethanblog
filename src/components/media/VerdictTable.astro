---
/**
 * VerdictTable — 零 JS 裁决表（Ink & Switch 评分卡范式，见 local-first 的「7 理想 × 候选方案」）。
 * 把"多方案 × 多维度"的抽象论证变成可扫读的裁决矩阵：✓ 满足 / — 部分满足 / ✗ 不满足，
 * 可选每格备注小字与条形图（0–100，宽度走 CSS 变量，颜色在 global.css 用 token）。
 */
type Verdict = 'yes' | 'partial' | 'no';

interface VerdictCell {
  verdict: Verdict;
  /** 符号下方的一行小字说明 */
  note?: string;
  /** 0–100，渲染为格内条形图 */
  bar?: number;
}

interface Props {
  /** 维度列头（如各项设计原则） */
  columns: string[];
  /** 每行一个方案；cells 与 columns 一一对应，可简写为 verdict 字符串 */
  rows: { label: string; cells: (Verdict | VerdictCell)[] }[];
  /** 左上角表头，默认「方案」 */
  corner?: string;
  /** mono 顶条标题（对齐 RuleGarden 的视觉语言） */
  title?: string;
  caption?: string;
}

const { columns, rows, corner = '方案', title, caption } = Astro.props;

const MARKS: Record<Verdict, { symbol: string; label: string; cls: string }> = {
  yes: { symbol: '✓', label: '满足', cls: 'vt-yes' },
  partial: { symbol: '—', label: '部分满足', cls: 'vt-partial' },
  no: { symbol: '✗', label: '不满足', cls: 'vt-no' },
};

const normalized = rows.map((row) => ({
  label: row.label,
  cells: row.cells.map((c) => (typeof c === 'string' ? { verdict: c } : c)),
}));
---

<figure class="media-frame not-prose" data-verdict-table>
  {
    title && (
      <div class="border-b border-surface-800 px-4 py-2 font-mono text-xs text-ink-500">
        {title}
      </div>
    )
  }
  <div class="vt-scroll">
    <table class="vt-table">
      <thead>
        <tr>
          <th scope="col">{corner}</th>
          {columns.map((col) => <th scope="col">{col}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          normalized.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.cells.map((cell) => {
                const mark = MARKS[cell.verdict];
                return (
                  <td>
                    <span class={mark.cls} aria-label={mark.label}>
                      {mark.symbol}
                    </span>
                    {cell.note && <span class="vt-note">{cell.note}</span>}
                    {typeof cell.bar === 'number' && (
                      <span
                        class="vt-bar"
                        style={`--vt-w: ${Math.min(100, Math.max(0, cell.bar))}%`}
                        aria-hidden="true"
                      />
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>
