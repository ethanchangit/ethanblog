---
/**
 * 推文引用：作者只给 url，构建期渲染完整正文。整块点进原帖。
 * 零 JS，无官方 widget、无点赞转发。失败时仍保留可点击的原文入口。
 */
import DateText from '@/components/shell/DateText.astro';
import I18n from '@/components/shell/I18n.astro';
import { loadTweet, parseTweetUrl } from '@/lib/tweet';

interface Props {
  url: string;
  caption?: string;
}

const { url, caption } = Astro.props;
const parsed = parseTweetUrl(url);
if (!parsed) {
  throw new Error(`TweetEmbed: 无法解析推文链接「${url}」。需要 https://x.com/<user>/status/<id>`);
}
const tweet = await loadTweet(parsed);
const created = tweet.createdAt ? new Date(tweet.createdAt) : undefined;
const dateOk = created && !Number.isNaN(created.valueOf());
const handle = tweet.screenName ? `@${tweet.screenName}` : '';
const ariaLabel = tweet.screenName
  ? `在 X 上查看 @${tweet.screenName} 的帖子`
  : '在 X 上查看这条帖子';
---

<figure class="media-frame not-prose">
  <a
    href={tweet.url}
    class="group block text-inherit no-underline"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={ariaLabel}
  >
    <p class="ui-meta">
      {
        tweet.name && (
          <span class="font-medium text-ink-200 transition-colors group-hover:text-ink-100">
            {tweet.name}
          </span>
        )
      }
      {
        handle && (
          <>
            {tweet.name ? ' ' : ''}
            <span>{handle}</span>
          </>
        )
      }
      {
        created && dateOk && (
          <>
            {' · '}
            <DateText date={created} />
          </>
        )
      }
      <span class="text-ink-400">
        {' · '}
        <I18n k="tweetView" />
      </span>
    </p>
    {
      tweet.text ? (
        <p class="mt-2 whitespace-pre-wrap text-sm leading-relaxed text-ink-300 sm:text-base">
          {tweet.text}
        </p>
      ) : (
        <p class="mt-2 text-sm leading-relaxed text-ink-400">
          <I18n k="tweetUnavailable" />
        </p>
      )
    }
    {
      tweet.quoted && (
        <p class="mt-3 text-sm leading-relaxed text-ink-400">
          <span class="ui-meta">
            {tweet.quoted.name} @{tweet.quoted.screenName}
          </span>
          <span class="mt-1 block whitespace-pre-wrap">{tweet.quoted.text}</span>
        </p>
      )
    }
    {
      tweet.photos.length > 0 && (
        <span class="mt-3 block space-y-3">
          {tweet.photos.map((photo) => (
            <span class="relative block">
              <img
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                class="block h-auto w-full"
              />
              {photo.video && (
                <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
                  <span class="flex h-12 w-12 items-center justify-center text-ink-200">
                    <svg width="22" height="22" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
                      <path d="M3 1.5v11a1 1 0 0 0 1.54.84l8-5.5a1 1 0 0 0 0-1.68l-8-5.5A1 1 0 0 0 3 1.5z" />
                    </svg>
                  </span>
                </span>
              )}
            </span>
          ))}
        </span>
      )
    }
  </a>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>
