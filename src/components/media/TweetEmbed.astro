---
/**
 * 自绘 X 卡片：构建期从 syndication / 本地缓存拉正文，用本站 chrome 渲染。
 * 长帖完整展开，不折叠、不「显示更多」；无关注、互动栏、回复入口；零 widgets.js。
 */
import I18n from '@/components/shell/I18n.astro';
import { formatTweetStamp } from '@/lib/format';
import { hiresAvatar, loadTweet, parseTweetUrl } from '@/lib/tweet';

interface Props {
  url: string;
  caption?: string;
}

const { url, caption } = Astro.props;
const parsed = parseTweetUrl(url);
if (!parsed) {
  throw new Error(`TweetEmbed: 无法解析推文链接「${url}」。需要 https://x.com/<user>/status/<id>`);
}
const tweet = await loadTweet(parsed);
const created = tweet.createdAt ? new Date(tweet.createdAt) : undefined;
const dateOk = created && !Number.isNaN(created.valueOf());
const handle = tweet.screenName ? `@${tweet.screenName}` : '';
const avatar = hiresAvatar(tweet.avatar);
const initial = (tweet.name || tweet.screenName || 'X').slice(0, 1);
const ariaLabel = tweet.screenName
  ? `在 X 上查看 @${tweet.screenName} 的帖子`
  : '在 X 上查看这条帖子';
---

<figure class="media-frame not-prose">
  <a
    class="tweet-embed block rounded-xl border border-surface-700 bg-surface-950 p-4 text-inherit no-underline transition-colors hover:bg-surface-800/40"
    href={tweet.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={ariaLabel}
    data-tweet-embed
  >
    <span class="flex items-start gap-3">
      {
        avatar ? (
          <img
            class="h-10 w-10 shrink-0 rounded-full object-cover"
            src={avatar}
            alt=""
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        ) : (
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface-800 text-sm font-semibold text-ink-200"
            aria-hidden="true"
          >
            {initial}
          </span>
        )
      }
      <span class="min-w-0 flex-1">
        <span class="flex items-center gap-1">
          {tweet.name && <span class="truncate font-bold text-ink-100">{tweet.name}</span>}
          {
            tweet.verified && (
              <span class="inline-flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-full bg-primary-500 text-surface-950">
                <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M4.7 9.2 1.8 6.3l1.1-1.1 1.8 1.8 4.4-4.4 1.1 1.1z"></path>
                </svg>
                <span class="sr-only"><I18n k="tweetVerified" /></span>
              </span>
            )
          }
        </span>
        {handle && <span class="mt-0.5 block truncate text-[15px] text-ink-500">{handle}</span>}
      </span>
      <svg
        class="mt-0.5 shrink-0 text-ink-100"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        aria-hidden="true"
      >
        <path
          fill="currentColor"
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.727-8.983L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"
        ></path>
      </svg>
    </span>

    {
      tweet.text ? (
        <span class="tweet-embed__body mt-3 block whitespace-pre-wrap break-words text-[15px] leading-relaxed text-ink-200">
          {tweet.text}
        </span>
      ) : (
        <span class="tweet-embed__body mt-3 block text-[15px] leading-relaxed text-ink-400">
          <I18n k="tweetUnavailable" />
        </span>
      )
    }

    {
      tweet.quoted && (
        <span class="mt-3 block rounded-xl border border-surface-700 p-3">
          <span class="block text-sm text-ink-500">
            {tweet.quoted.name} @{tweet.quoted.screenName}
          </span>
          <span class="mt-1 block whitespace-pre-wrap break-words text-[15px] leading-relaxed text-ink-300">
            {tweet.quoted.text}
          </span>
        </span>
      )
    }

    {
      tweet.photos.length > 0 && (
        <span class="mt-3 block space-y-3">
          {tweet.photos.map((photo) => (
            <span class="relative block overflow-hidden rounded-xl">
              <img
                class="block h-auto w-full"
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
              {photo.video && (
                <span class="pointer-events-none absolute inset-0 flex items-center justify-center" aria-hidden="true">
                  <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ink-100/85 pl-0.5 text-surface-950">
                    <svg viewBox="0 0 14 14" width="18" height="18">
                      <path
                        fill="currentColor"
                        d="M3 1.5v11a1 1 0 0 0 1.54.84l8-5.5a1 1 0 0 0 0-1.68l-8-5.5A1 1 0 0 0 3 1.5z"
                      ></path>
                    </svg>
                  </span>
                </span>
              )}
            </span>
          ))}
        </span>
      )
    }

    {
      created && dateOk && (
        <span class="mt-3 block text-[13px] text-ink-500">
          <span class="i18n-zh">{formatTweetStamp(created, 'zh-CN')}</span>
          <span class="i18n-en" aria-hidden="true">{formatTweetStamp(created, 'en')}</span>
        </span>
      )
    }
  </a>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>
