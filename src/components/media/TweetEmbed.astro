---
/**
 * 官方 X 嵌入：blockquote.twitter-tweet + widgets.js。
 * 作者只给 url；无 JS 时降级为帖子正文和原文链接。
 */
import { formatDate } from '@/lib/format';
import { loadTweet, parseTweetUrl } from '@/lib/tweet';

interface Props {
  url: string;
  caption?: string;
}

const { url, caption } = Astro.props;
const parsed = parseTweetUrl(url);
if (!parsed) {
  throw new Error(`TweetEmbed: 无法解析推文链接「${url}」。需要 https://x.com/<user>/status/<id>`);
}
const tweet = await loadTweet(parsed);
const created = tweet.createdAt ? new Date(tweet.createdAt) : undefined;
const dateOk = created && !Number.isNaN(created.valueOf());
const permalink = `https://twitter.com/${tweet.screenName || parsed.screenName || 'i'}/status/${parsed.id}`;
const byline = [tweet.name, tweet.screenName ? `@${tweet.screenName}` : ''].filter(Boolean).join(' ');
---

<figure class="media-frame not-prose">
  <blockquote class="twitter-tweet" data-dnt="true" data-conversation="none">
    {tweet.text ? <p>{tweet.text}</p> : null}
    {byline ? <>{'\u2014'} {byline}{' '}</> : null}
    <a href={permalink}>{dateOk && created ? formatDate(created, 'en') : permalink}</a>
  </blockquote>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>

<script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
<script>
  // @ts-nocheck
  function currentTheme() {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function applyTweetTheme(theme) {
    document.querySelectorAll('blockquote.twitter-tweet').forEach((el) => {
      el.setAttribute('data-theme', theme);
    });
  }

  function loadTwitterWidgets() {
    applyTweetTheme(currentTheme());
    window.twttr?.widgets?.load();
  }

  loadTwitterWidgets();
  document.addEventListener('astro:page-load', loadTwitterWidgets);

  if (!window.__tweetEmbedThemeBound) {
    window.__tweetEmbedThemeBound = true;
    new MutationObserver(() => {
      const theme = currentTheme();
      document.querySelectorAll('iframe[src*="platform.twitter.com/embed/Tweet.html"]').forEach((frame) => {
        const src = new URL(frame.src);
        if (src.searchParams.get('theme') === theme) return;
        src.searchParams.set('theme', theme);
        frame.src = src.toString();
      });
      applyTweetTheme(theme);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>
