---
/**
 * RuleGarden — Astro 薄包装，保留 MDX 零指令用法（对齐 CodePlayground 范式）。
 * SSR 由 Svelte 岛屿用 describeRules 渲染降级散文；
 * client:visible 注水后变成可开关、改写、添加的规则花园（Claim/When/Wish 的网页玩具版）。
 */
import RuleGardenIsland from './RuleGarden.svelte';
import type { Rule } from '@/lib/rules/types';

interface Props {
  rules: Rule[];
  title?: string;
  caption?: string;
}

const props = Astro.props as Props;
---

<RuleGardenIsland client:visible {...props} />
