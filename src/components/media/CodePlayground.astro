---
/**
 * CodePlayground — Astro 薄包装，保留 MDX 零指令用法。
 * SSR 由 Svelte 岛屿提供只读代码降级；client:visible 后 Run 按钮启用 Sandpack 沙箱。
 */
import CodePlaygroundIsland from './CodePlayground.svelte';
import type { PlaygroundFile, PlaygroundTemplate } from '@/lib/sandpack/setup';

interface Props {
  code: string;
  lang?: string;
  title?: string;
  caption?: string;
  files?: Record<string, PlaygroundFile>;
  template?: PlaygroundTemplate;
}

const props = Astro.props as Props;
---

<CodePlaygroundIsland client:visible {...props} />
