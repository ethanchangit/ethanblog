---
/**
 * CodePlayground（Phase 1 stub）：
 * 目前渲染 Shiki 高亮的只读代码块 + 禁用的 Run 按钮。
 * 真正的可运行沙箱（Sandpack / WebContainer）在组件库路线图上。
 */
import { Code } from 'astro:components';
import type { BundledLanguage } from 'shiki';

interface Props {
  code: string;
  lang?: BundledLanguage;
  title?: string;
  caption?: string;
}

const { code, lang = 'javascript', title = 'playground.js', caption } = Astro.props;
---

<figure class="media-frame not-prose">
  <div class="flex items-center justify-between border-b border-surface-800 bg-surface-950/60 px-4 py-2.5">
    <p class="font-mono text-xs text-ink-400">{title}</p>
    <button
      type="button"
      disabled
      title="在线运行即将上线"
      class="cursor-not-allowed rounded bg-surface-800 px-3 py-1 font-mono text-xs text-ink-600"
    >
      ▶ Run（即将上线）
    </button>
  </div>
  <div class="overflow-x-auto p-4 text-sm [&_pre]:!bg-transparent">
    <Code code={code} lang={lang} theme="vesper" />
  </div>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>
