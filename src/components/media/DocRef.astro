---
import Card from '@/components/shell/Card.astro';
import { includeDraftsInDev, resolveDocRef } from '@/lib/docs';
import { docCardProps } from '@/lib/tags';

interface Props {
  of: string;
}

const { of } = Astro.props;
const entry = await resolveDocRef(of, { includeDrafts: includeDraftsInDev });
const card = docCardProps(entry);
const lp = Astro.locals.localePath;
---

<Card
  href={lp(card.href)}
  title={card.title}
  description={card.description}
  meta={card.meta}
  tags={card.tags}
/>
